# coldstore archive layer — copy to a private env file outside the repo and `source` it.
export COLDSTORE_ARCHIVE_WS="$HOME/.coldstore/archive"                  # ledgers, sqlite vault, manifests (never committed)
export COLDSTORE_GPG_KEYFILE="$HOME/.coldstore/secrets/gpg.passphrase"  # symmetric GPG passphrase file, mode 0600, never in repo
export COLDSTORE_CLOUD_BASE="/ColdArchive"                    # folder inside the cloud drive holding encrypted blobs
export COLDSTORE_STAGE_DIR="ColdArchive"                                  # desktop-client Documents subfolder used as upload stage
export COLDSTORE_REMOTE="user@host-b"                                     # ssh target of the second host (GPU/storage box)
export COLDSTORE_REMOTE_ARCHIVE_WS="/home/user/.coldstore/archive"
export COLDSTORE_ICLOUD_DIR="$HOME/Library/Mobile Documents/com~apple~CloudDocs/coldstore-recovery"
export COLDSTORE_ALLOWED_PREFIXES="/home/user/project-a/:/home/user/archive/:/data/asset-pool-v3/"   # colon-separated evictable roots
export COLDSTORE_PAGER_PATHS="$HOME/.coldstore/pager_paths.json"
export COLDSTORE_PAGER_POLICY="$HOME/.coldstore/etc/workspace_pager_policy.json"
