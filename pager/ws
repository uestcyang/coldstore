    pp = page_sub.add_parser("classify", help="声明淘汰后仍存在的独立副本数；未分类永不淘汰")
    pp.add_argument("target")
    pp.add_argument("--class", dest="redundancy_class", required=True,
                    choices=("REGENERABLE", "CLOUD_ACCEPTED", "VALUABLE", "IRREPLACEABLE"))
    pp.add_argument("--copies", type=int, required=True,
                    help="不含当前本地源、淘汰后仍存在的独立副本数")
