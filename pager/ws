                    help="仅当 semantic_stale_task=MULTIPLE(多个 task 抢过 owner)时,由维护侧显式收口;对其它 owner 不匹配无效")
    pp.add_argument("target")
    pp.add_argument("--summary", required=True)
    pp.add_argument("--keyword", action="append", default=[])
    pp.add_argument("--actor", required=True)
    pp.add_argument("--task-id")
    pp.add_argument("--timeout", type=float, default=900)
    pp.add_argument("--json", action="store_true")
    pp = page_sub.add_parser(
        "retry-annotation-sync",
        help="幂等重试已落本地、但云同步失败的语义注释；不增加revision",
    )
    pp.add_argument("target")
    pp.add_argument("--timeout", type=float, default=900)
    pp.add_argument("--json", action="store_true")
    pp = page_sub.add_parser("semantic-ingest", help=argparse.SUPPRESS)
    pp.add_argument("--incoming", required=True)
    pp.add_argument("--timeout", type=float, default=900)
    pp.add_argument("--json", action="store_true")
    pp = page_sub.add_parser("touch", help="逻辑访问并取得HOT租约")
