# ============================================================================
# who —— 工作区并发工人占用表(occupancy,<date> operator directive)。每个工作区根下 .ws_workers/<task_id>.json
# 由 dispatcher.py 派单时写,心跳挂在它已有的轮询循环里续。这里只读、
# 只在读到过期(心跳超过 WS_WORKER_STALE_SEC 秒没更新)记录时顺手清掉本机的
# ——这就是租约,任何一方都可以清,不引入任何新依赖。
# 跨机:同名工作区在对侧机器也可能有工人在跑,读对侧走 ssh,复用的是本文件
# 已有的 PEER_SSH/ConnectTimeout=6/BatchMode=yes 判据(与 dispatcher.py
# 的 _ws_probe/_XHOST_BY_PREFIX 同一套家族:固定 host 映射、固定超时、
# 固定 BatchMode),不新起一套 SSH 逻辑。对侧不可达/无内容 → 降级返回空,
# 不报错、不影响本机结果。
# ============================================================================
WS_WORKERS_DIRNAME = ".ws_workers"
WS_WORKER_STALE_SEC = 180


def _ws_parse_iso(s):
    if not s:
        return None
    try:
        s2 = s[:-1] if s.endswith("Z") else s
        return calendar.timegm(time.strptime(s2, "%Y-%m-%dT%H:%M:%S"))
    except Exception:
        return None


def _ws_rec_age(rec):
    hb = _ws_parse_iso(rec.get("heartbeat"))
    return (time.time() - hb) if hb is not None else None


def _ws_fmt_age(sec):
    if sec is None or sec < 0:
        return "?"
    sec = int(sec)
    if sec < 60:
        return "%ds" % sec
    if sec < 3600:
        return "%dm" % (sec // 60)
    return "%dh" % (sec // 3600)


def _ws_load_local_occupancy(path, reap=True):
    """读本机 path/.ws_workers/*.json。心跳过期的:reap=True 时删文件,
    两种情况都把该记录归进 reaped 返回(方便调用方打印"已清理"提示)。"""
    d = os.path.join(path, WS_WORKERS_DIRNAME)
    alive, reaped = [], []
    if not os.path.isdir(d):
        return alive, reaped
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return alive, reaped
    for fn in names:
        if not fn.endswith(".json"):
            continue
        fp = os.path.join(d, fn)
        try:
            rec = json.load(open(fp, encoding="utf-8"))
        except Exception:
            continue
        rec.setdefault("host", HOST)
        age = _ws_rec_age(rec)
        rec["_age"] = age
        if age is None or age > WS_WORKER_STALE_SEC:
            if reap:
                try:
                    os.remove(fp)
                except OSError:
                    pass
            reaped.append(rec)
        else:
            alive.append(rec)
    return alive, reaped


def _ws_peer_occupancy(paths):
    """跨机批量读对侧同名工作区的 .ws_workers/*.json,一次 ssh 往返。
    返回 {path: [rec,...]}(只含未过期的活记录);对侧不可达 → {}。"""
    paths = [p for p in (paths or []) if p]
    if not paths:
        return {}
    parts = []
    for p in paths:
        d = os.path.join(p, WS_WORKERS_DIRNAME)
        parts.append('echo "===WS_WHO==="; echo %s; '
                      'for f in %s/*.json; do [ -f "$f" ] && cat "$f" && echo; done 2>/dev/null'
                      % (shlex.quote(p), shlex.quote(d)))
    sh = "\n".join(parts)
    try:
        r = subprocess.run(
            ["ssh", "-o", "ConnectTimeout=6", "-o", "BatchMode=yes", PEER_SSH,
             "bash -lc %s" % shlex.quote(sh)],
            capture_output=True, text=True, timeout=30)
    except Exception:
        return {}
    if r.returncode != 0 and not (r.stdout or "").strip():
        return {}
    result, cur = {}, None
    for line in (r.stdout or "").splitlines():
        s = line.rstrip("\n")
        if s == "===WS_WHO===":
            cur = None
            continue
        if cur is None:
            cur = s
            result.setdefault(cur, [])
            continue
        if s.strip():
            try:
                rec = json.loads(s)
            except Exception:
                continue
            rec.setdefault("host", PEER_HOST)
            age = _ws_rec_age(rec)
            if age is not None and age <= WS_WORKER_STALE_SEC:
                rec["_age"] = age
                result[cur].append(rec)
    return result


def _ws_print_who_block(path, alive, reaped):
    if not alive and not reaped:
        print("%s — 当前没有活工人" % path)
        return
    print("%s — %d 个活工人" % (path, len(alive)))
    for rec in sorted(alive, key=lambda r: r.get("started") or ""):
        print("  [%-4s] %-28s %-20s 心跳 %s前   %s" % (
            rec.get("host", "?"), rec.get("task_id", "?"),
            (rec.get("label") or "")[:20], _ws_fmt_age(rec.get("_age")),
            rec.get("what", "")))
    for rec in reaped:
        print("  (已清理 1 个死工人: %s 心跳 %s前)" % (
            rec.get("task_id", "?"), _ws_fmt_age(rec.get("_age"))))


def cmd_who(target):
    if target:
        path = os.path.abspath(os.path.expanduser(target))
        alive, reaped = _ws_load_local_occupancy(path, reap=True)
        peer = _ws_peer_occupancy([path]).get(path, [])
        _ws_print_who_block(path, alive + peer, reaped)
        return 0
    # 无参数:扫全量索引,只列出当前有活工人的工作区
    cache = load_index()
    recs = list(cache["records"].values())
    local_paths = sorted({r["path"] for r in recs if r["host"] == HOST})
    remote_paths = sorted({r["path"] for r in recs if r["host"] != HOST})
    peer_local_dump = _ws_peer_occupancy(local_paths) if local_paths else {}
    peer_remote_dump = _ws_peer_occupancy(remote_paths) if remote_paths else {}
    any_hit = False
    for p in local_paths:
        alive, reaped = _ws_load_local_occupancy(p, reap=True)
        alive = alive + peer_local_dump.get(p, [])
        if alive or reaped:
            any_hit = True
            _ws_print_who_block(p, alive, reaped)
    for p in remote_paths:
        alive = peer_remote_dump.get(p, [])
        if alive:
            any_hit = True
            _ws_print_who_block(p, alive, [])
    if not any_hit:
        print("全量索引扫描完毕:当前没有工作区有活工人。")
    return 0


