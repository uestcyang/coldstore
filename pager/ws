# 原子追加(独立锁文件,详见文件头注释——不能靠 rename 后的旧 fd 当锁句柄)
# ============================================================================

def _locked_rewrite(hp, mutate_fn):
    """mutate_fn(lines:list[str]) -> list[str] | None(None=不写,已处理如"已存在跳过")。
    返回 (ok, message)。"""
    if not os.path.isfile(hp):
        return False, "HANDOFF.md 不存在: %s(先用 ws new 建区)" % hp
    lockpath = hp + ".lock"
    lockf = open(lockpath, "a+")
    try:
        fcntl.flock(lockf, fcntl.LOCK_EX)
        text = open(hp, encoding="utf-8").read()
        lines = text.splitlines()
        new_lines, msg = mutate_fn(lines)
        if new_lines is None:
            return True, msg
        new_text = "\n".join(new_lines)
        if not new_text.endswith("\n"):
            new_text += "\n"
        tmp = hp + ".tmp.%d" % os.getpid()
        with open(tmp, "w", encoding="utf-8") as tf:
            tf.write(new_text)
        os.replace(tmp, hp)
        _invalidate_index(hp)
        # <date>: `ws --selftest` promises 全隔离/绝不碰真缓存, but this hook was
        # registering every /tmp/ws_selftest_* workspace as a live HOT page in the
        # production page table (72 rows on Mac, 28 on hostb, dirs long gone).
        if (os.environ.get("WS_SELFTEST") != "1"
                and not os.path.dirname(hp).startswith("/tmp/ws_selftest_")):
            try:
                pager.WorkspacePager().mark_dirty(HOST, os.path.dirname(hp), "HANDOFF write")
            except Exception as exc:
                print("警告:页表标脏失败:%s" % exc, file=sys.stderr)
        return True, msg
    finally:
        try:
            fcntl.flock(lockf, fcntl.LOCK_UN)
        except Exception:
            pass
        lockf.close()


def _append_to_block(lines, block_name, new_line):
    idx = _block_ranges(lines)
    if block_name not in idx:
        raise ValueError("缺块 [%s],无法追加(规范要求四大块齐全)" % block_name)
    start = idx[block_name]
    later = sorted(v for v in idx.values() if v > start)
    end = later[0] if later else len(lines)
    insert_at = start + 1
    for j in range(end - 1, start, -1):
        if lines[j].strip():
            insert_at = j + 1
            break
    return lines[:insert_at] + [new_line] + lines[insert_at:]


