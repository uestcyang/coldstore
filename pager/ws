def _fmt_skill_list(skills):
    star = [s["name"] for s in skills if s.get("star")]
    allnames = [s["name"] for s in skills]
    return star, allnames


def print_record(rec, host_note=True):
    tag = "" if rec["host"] == HOST else " [对侧:%s]" % rec["host"]
    print("路径: %s%s" % (rec["path"], tag))
    if not rec.get("has_handoff"):
        print("  这是什么: (尚无 HANDOFF.md — 候选工作区,证据: %s)" % rec.get("evidence", ""))
        print("  建议: ws new %s --what \"...\" --line <产线>" % rec["path"])
        print("")
        return
    fresh = refresh_local_record(rec)
    print("  这是什么: %s" % (fresh.get("what") or "(未填)"))
    print("  产线: %s" % (fresh.get("line") or "无"))
    star, allnames = _fmt_skill_list(fresh.get("skills", []))
    print("  ⭐必用skill: %s" % (", ".join(star) if star else "(无标星)"))
    print("  全部skill: %s" % (", ".join(allnames) if allnames else "(空)"))
    print("  当前态: 做到哪=%s | 下一道门=%s | 卡点=%s" % (
        fresh.get("progress") or "(未填)", fresh.get("next_gate") or "(未填)",
        fresh.get("blocker") or "(未填)"))
    if host_note and rec["host"] != HOST:
        print("  (只读展示,来自索引缓存;如需操作请: ssh %s '~/.coldstore/bin/ws ...')" % PEER_SSH)
    if fresh.get("recent_task"):
        print("  最近任务: " + recent_task_text(fresh))
    print("")


def cmd_find(keyword_args):
    kws = []
    for a in keyword_args:
        kws.extend(a.split())
    kws = [k.lower() for k in kws if k]
    if not kws:
        print("用法: ws find <关键词...>")
        return 2
    cache = load_index()
    _report_cache_status(cache)
    scored = []
    for rec in cache["records"].values():
        hay = " ".join([
            rec.get("path", ""), rec.get("name", ""), rec.get("what", ""),
            rec.get("line", ""), rec.get("progress", ""), rec.get("next_gate", ""),
            rec.get("blocker", ""),
            recent_task_text(rec),
            " ".join(s.get("name", "") for s in rec.get("skills", [])),
            " ".join(rec.get("dispatch_labels", [])),
        ]).lower()
        hits = sum(1 for k in kws if k in hay)
        if hits > 0:
            scored.append((hits, rec))
    if not scored:
        print("NO_MATCH")
        print("没有工作区匹配关键词「%s」。" % " ".join(kws))
        print("若本任务会产生持久产物,建议建区:")
        print("  ws new <路径> --what \"这是什么\" --line <产线>")
        return 0
    scored.sort(key=lambda x: (-x[0], x[1]["path"]))
    for hits, rec in scored[:10]:
        print_record(rec)
    return 0


def cmd_list():
    cache = load_index()
