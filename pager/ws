def _page_sync(cache):
    pg = pager.WorkspacePager()
    pg.sync(cache.get("records", {}), cache.get("assets", []), HOST)
    # 第三条 sync 路径。<date> 我先只改了 main() 里那两条,是新加的 AST
    # 用例把这处揪出来的 —— 正是"判据必须守语义而不是守我记得的那几行"。
    _refresh_liveness_after_sync(pg)
    return pg


def _page_record(cache, target, pg=None):
    # A page operation is not a search. Never substitute a child whose path
    # merely contains the requested root (<date> archive starvation).
    if target.startswith(("/", "~", ".")):
        absolute = os.path.abspath(os.path.expanduser(target)).rstrip("/") or "/"
        matches = [r for r in cache.get("records", {}).values()
                   if r["path"].rstrip("/") == absolute]
        if not matches and pg is not None:
            matches = [r for r in pg.status(absolute)["rows"]
                       if r["path"].rstrip("/") == absolute]
        if len(matches) > 1:
            raise pager.PagerRefused("REFUSE_PAGE_TARGET_AMBIGUOUS %s" % target)
        if matches:
            return matches[0]
        hp = os.path.join(absolute, "HANDOFF.md")
        if os.path.isfile(hp):
            return build_record_from_file(hp, HOST)
        raise pager.PagerRefused("REFUSE_PAGE_WORKSPACE_NOT_FOUND %s" % target)
    rec = _resolve_target(cache, target)
    if not rec and pg is not None:
        matches = pg.status(target)["rows"]
        if len(matches) > 1:
            raise pager.PagerRefused("REFUSE_PAGE_TARGET_AMBIGUOUS %s" % target)
        if matches:
            return matches[0]
    if not rec:
        raise pager.PagerRefused("REFUSE_PAGE_WORKSPACE_NOT_FOUND %s" % target)
    return rec


def _page_path_exists(host, path):
    if host == HOST:
        return os.path.exists(path)
    try:
        r = subprocess.run(
            ["ssh", "-o", "ConnectTimeout=6", "-o", "BatchMode=yes", PEER_SSH,
             "test -e %s" % shlex.quote(path)], timeout=10,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return r.returncode == 0
    except Exception:
        return False


def _page_archive_root(asset_id):
    heads = pager.CLOUD_WORKSPACE / "vault_v2_heads.json"
    if heads.is_file():
        try:
            doc = json.loads(heads.read_text(encoding="utf-8"))
            head = (doc.get("heads") or {}).get(asset_id)
        except (OSError, json.JSONDecodeError) as exc:
            raise pager.PagerRefused("REFUSE_VERSION_HEADS_UNREADABLE %s" % exc)
        if not head or not head.get("root"):
            raise pager.PagerRefused("REFUSE_ASSET_WITHOUT_CURRENT_HEAD %s" % asset_id)
        return head["root"]
    ledger = pager.CLOUD_WORKSPACE / "vault_v2_ledger.tsv"
    latest = {}
    try:
        for line in ledger.read_text(encoding="utf-8").splitlines():
            cols = line.split("\t")
            if len(cols) == 12:
                latest[(cols[1], cols[3])] = cols
    except OSError as exc:
        raise pager.PagerRefused("REFUSE_LEDGER_UNREADABLE %s" % exc)
    roots = {r[1] for r in latest.values() if r[2] == asset_id and r[11] == "CLOUD_CONFIRMED"}
    if len(roots) != 1:
        raise pager.PagerRefused(
            "REFUSE_ARCHIVE_ROOT_COUNT asset=%s count=%d" % (asset_id, len(roots)))
    return roots.pop()


def _page_materialize(asset, restored):
    archive_root = _page_archive_root(asset["asset_id"])
    if archive_root.startswith("manifest://"):
        raise pager.PagerRefused(
            "REFUSE_MANIFEST_ASSET_WHOLE_MATERIALIZE %s" % asset["asset_id"])
    original = asset["original_path"]
    base = os.path.basename(original.rstrip("/"))
    source = os.path.join(str(restored), base)
    if not os.path.lexists(source):
        raise pager.PagerRefused("REFUSE_RESTORE_LAYOUT source_missing=%s" % source)
    if asset["host"] == HOST:
        if os.path.lexists(original):
            raise pager.PagerRefused("REFUSE_MATERIALIZE_TARGET_EXISTS %s" % original)
        os.makedirs(os.path.dirname(original), exist_ok=True)
        try:
            os.replace(source, original)
        except OSError as exc:
            raise pager.PagerRefused(
                "REFUSE_MATERIALIZE_NOT_ATOMIC source=%s target=%s error=%s"
                % (source, original, exc))
        return original
    if HOST != "mac" or asset["host"] != "hostb":
        raise pager.PagerRefused(
            "REFUSE_MATERIALIZE_WRONG_CONTROL_HOST current=%s target=%s" % (HOST, asset["host"]))
    parent = os.path.dirname(original)
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", asset["asset_id"])[:80]
    stage_parent = os.path.join(parent, ".ws-page-in-%s-%d" % (safe, os.getpid()))
    pre = (
        "test ! -e {target} && test ! -e {stage} && "
        'sudo -n install -d -m 700 -o "$(id -u)" -g "$(id -g)" {stage}'
    ).format(target=shlex.quote(original), stage=shlex.quote(stage_parent))
    r = subprocess.run(
        ["ssh", "-o", "ConnectTimeout=6", "-o", "BatchMode=yes", PEER_SSH, pre],
        text=True, capture_output=True, timeout=30)
    if r.returncode != 0:
        raise pager.PagerRefused(
            "REFUSE_REMOTE_STAGE_PREP rc=%d stderr=%s" % (r.returncode, r.stderr[-1000:]))
    tar = subprocess.Popen(
        ["/usr/bin/tar", "-C", str(restored), "-cf", "-", "--", base],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    # Mac's unprivileged extraction owns the transport cache as its local UID.
    # Those numeric IDs are not identities on Linux. Public workspace restores
    # belong to the destination SSH operator, retaining archived file modes.
    remote_extract = "/usr/bin/tar --no-same-owner --same-permissions -C %s -xf -" % shlex.quote(stage_parent)
    remote = subprocess.run(
        ["ssh", "-o", "ConnectTimeout=6", "-o", "BatchMode=yes", PEER_SSH,
         remote_extract], stdin=tar.stdout, text=False, capture_output=True)
    assert tar.stdout
    tar.stdout.close()
    tar_stderr = tar.stderr.read() if tar.stderr else b""
    tar_rc = tar.wait()
    if tar_rc != 0 or remote.returncode != 0:
        raise pager.PagerRefused(
            "REFUSE_REMOTE_TRANSFER local_rc=%d remote_rc=%d local=%s remote=%s "
            "staging_retained=%s" % (
                tar_rc, remote.returncode, tar_stderr[-1000:].decode(errors="replace"),
                remote.stderr[-1000:].decode(errors="replace"), stage_parent))
    staged = os.path.join(stage_parent, base)
    promote = (
        "test ! -e {target} && test -e {staged} && "
        "sudo -n mv -- {staged} {target} && sudo -n rmdir -- {stage}"
    ).format(target=shlex.quote(original), staged=shlex.quote(staged),
             stage=shlex.quote(stage_parent))
    r = subprocess.run(
        ["ssh", "-o", "ConnectTimeout=6", "-o", "BatchMode=yes", PEER_SSH, promote],
        text=True, capture_output=True, timeout=60)
    if r.returncode != 0:
        raise pager.PagerRefused(
            "REFUSE_REMOTE_ATOMIC_PROMOTE rc=%d stderr=%s staging_retained=%s"
            % (r.returncode, r.stderr[-1000:], stage_parent))
    return original


def _page_refresh_materialized_catalog(asset):
    result = subprocess.run(
        [sys.executable, str(pager.CLOUD_WORKSPACE / 'cloud_asset_catalog.py')],
        capture_output=True, text=True, timeout=180)
    if result.returncode:
        raise pager.PagerRefused('REFUSE_MATERIALIZED_CATALOG_REFRESH')
    current = pager.find_asset(pager.load_assets(), asset['asset_id'])
    if (current.get('original_path') != asset['original_path']
            or current.get('host') != asset['host']
            or current.get('local_state') not in {'local', 'replicated'}):
        raise pager.PagerRefused('REFUSE_MATERIALIZED_CATALOG_PRESENCE')


def _page_finish_materialize(pg, asset, restored):
    """Release the transport cache only after successful atomic placement."""
    materialized = _page_materialize(asset, restored)
    _page_refresh_materialized_catalog(asset)
    pg.mark_materialized(asset["asset_id"], "atomic materialize PASS")
    pager.discard_restore_cache(asset["asset_id"])
    return materialized


def _semantic_cloud_ingest(incoming_path, timeout):
    """Merge one staged export and sync the Mac cloud authority under one lock."""
    if not IS_MAC:
        raise pager.PagerRefused("REFUSE_SEMANTIC_INGEST_NOT_MAC_AUTHORITY")
    incoming = pager.Path(incoming_path)
    temp_roots = {
        pager.Path(tempfile.gettempdir()).resolve(),
        pager.Path("/tmp").resolve(),
    }
    try:
        resolved = incoming.resolve(strict=True)
        stat_result = incoming.lstat()
    except OSError as exc:
        raise pager.PagerRefused(
            "REFUSE_SEMANTIC_INCOMING_UNREADABLE %s: %s" % (incoming, exc)
        ) from exc
    if (incoming.is_symlink() or not incoming.is_file() or stat_result.st_uid != os.getuid() or
            resolved.parent not in temp_roots or not resolved.name.startswith("ws_semantics_")):
        raise pager.PagerRefused("REFUSE_SEMANTIC_INCOMING_PATH %s" % incoming)
    authority = pager.CLOUD_WORKSPACE / "workspace_semantics.jsonl"
    lock_path = pager.CLOUD_WORKSPACE / ".workspace_semantics_sync.lock"
    try:
        with lock_path.open("a+", encoding="utf-8") as lock_handle:
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
            merged = pager.merge_semantic_exports(authority, incoming)
            outputs = []
            for tool in (pager.CLOUD_WORKSPACE / "cloud_asset_catalog.py",
                         pager.CLOUD_WORKSPACE / "vault_v2_sync.py"):
                if not tool.is_file():
                    raise pager.PagerRefused(
                        "REFUSE_SEMANTIC_CLOUD_TOOL_MISSING %s" % tool
                    )
                proc = subprocess.run(
                    [sys.executable, str(tool)], text=True, capture_output=True,
                    timeout=timeout, stdin=subprocess.DEVNULL,
                )
                if proc.returncode:
                    raise pager.PagerRefused(
                        "REFUSE_SEMANTIC_CLOUD_SYNC tool=%s rc=%d detail=%s" % (
                            tool, proc.returncode, (proc.stdout + proc.stderr)[-2000:])
                    )
                outputs.append((proc.stdout + proc.stderr).strip()[-1000:])
            return {"merge": merged, "tools": outputs}
    finally:
        # Only the validated, per-call /tmp staging file is removed.  Authority,
        # source workspaces and cloud copies are never deletion targets here.
        if incoming.exists() and not incoming.is_symlink():
            incoming.unlink(missing_ok=True)


def _semantic_export_and_sync(pg, timeout):
    """Export local pager semantics and route them to the Mac authority."""
    fd, stage_raw = tempfile.mkstemp(prefix="ws_semantics_%s_" % HOST, suffix=".jsonl")
    os.close(fd)
    stage = pager.Path(stage_raw)
    try:
        exported = pg.export_semantics(stage)
        if IS_MAC:
            result = _semantic_cloud_ingest(stage, timeout)
            stage = None
            return exported, result
        mktemp_proc = subprocess.run(
            ["ssh", "-n", "-o", "ConnectTimeout=6", "-o", "BatchMode=yes",
             PEER_SSH, "umask 077; mktemp /tmp/ws_semantics_hostb.jsonl.XXXXXX"],
            text=True, capture_output=True, timeout=15, stdin=subprocess.DEVNULL,
        )
        if mktemp_proc.returncode:
            raise pager.PagerRefused(
                "REFUSE_SEMANTIC_REMOTE_STAGE rc=%d detail=%s" % (
                    mktemp_proc.returncode, (mktemp_proc.stdout + mktemp_proc.stderr)[-1000:])
            )
        remote_stage = mktemp_proc.stdout.strip()
        if not remote_stage.startswith("/tmp/ws_semantics_hostb."):
            raise pager.PagerRefused("REFUSE_SEMANTIC_REMOTE_STAGE_PATH %s" % remote_stage)
        copy_proc = subprocess.run(
            ["scp", "-q", "-o", "ConnectTimeout=6", "-o", "BatchMode=yes",
             str(stage), "%s:%s" % (PEER_SSH, remote_stage)],
            text=True, capture_output=True, timeout=60, stdin=subprocess.DEVNULL,
        )
        if copy_proc.returncode:
            raise pager.PagerRefused(
                "REFUSE_SEMANTIC_REMOTE_COPY rc=%d detail=%s" % (
                    copy_proc.returncode, (copy_proc.stdout + copy_proc.stderr)[-1000:])
            )
        remote_cmd = "~/.coldstore/bin/ws page semantic-ingest --incoming %s --timeout %s --json" % (
            shlex.quote(remote_stage), float(timeout),
        )
        sync_proc = subprocess.run(
            ["ssh", "-n", "-o", "ConnectTimeout=6", "-o", "BatchMode=yes",
             PEER_SSH, remote_cmd],
            text=True, capture_output=True, timeout=timeout + 30,
            stdin=subprocess.DEVNULL,
        )
        if sync_proc.returncode:
            raise pager.PagerRefused(
                "REFUSE_SEMANTIC_REMOTE_SYNC rc=%d detail=%s" % (
                    sync_proc.returncode, (sync_proc.stdout + sync_proc.stderr)[-2000:])
            )
        return exported, {"remote": sync_proc.stdout.strip()[-2000:]}
    finally:
        if stage is not None:
            stage.unlink(missing_ok=True)


# ── ws page status 同步节流(<date>) ──────────────────────────────────
# sync() 是全机队写操作;status 是只读查询。让只读路径每次都触发全量写,等于
# 把共享库的写锁按调用频率放大,这是产线级的锁竞争源,不是性能小事。
_PAGE_SYNC_STAMP = os.path.join(
    os.path.expanduser("~"), ".coldstore", "state", "ws_page_sync.stamp")
_PAGE_SYNC_TTL = 300.0


def _page_sync_is_fresh():
    try:
        return (time.time() - os.stat(_PAGE_SYNC_STAMP).st_mtime) < _PAGE_SYNC_TTL
    except OSError:
        return False


def _mark_page_synced():
    try:
        os.makedirs(os.path.dirname(_PAGE_SYNC_STAMP), exist_ok=True)
        with open(_PAGE_SYNC_STAMP, "w") as fh:
            fh.write(str(int(time.time())))
    except OSError:
        # 打不上时间戳只会退化成"每次都同步"(即旧行为),不能因此让命令失败。
        pass


def _refresh_liveness_after_sync(pg):
    """每次真实 sync 之后刷新文件系统活跃度探针。

    <date>:`WorkspacePager.refresh_tree_liveness` 自 <date> 立起,写了
    实现、配了单测(test_workspace_pager.py 两处 + safety 一处),但**生产路径零
    调用** —— 全库 grep 只有测试在调。实测后果不是少一条日志:

      · `tree_recent` 全库 2486 行全为 NULL,`TREE_LIVENESS_PROBE` 事件 0 条
      · plan() 对 local_present=1 的页要求 tree_recent==0 才判 EVICT_CANDIDATE,
        拿不到探针就恒判 LIVENESS_PROBE_REQUIRED
      · 于是 519 个页永久出不了候选池,压力淘汰长期"候选 0"饿死,只能靠人手删

    首次真跑(11.85 秒)的判据:LIVENESS_PROBE_REQUIRED 519→213、
    EVICT_CANDIDATE 0→212、ARCHIVE_CANDIDATE 0→46、候选池 0→127.74 GiB。

    探针自带 6 小时 TTL 且只重探 stale 行,所以挂在每拍 sync 之后是廉价的:
    稳态 0 次探测,全量首跑 11.85 秒(find -newermt -print -quit 短路)。

    两条刻意的降级语义,别当成疏漏:
      1) 只读实例直接跳过 —— refresh 要写 tree_recent,只读连接会抛
         "attempt to write a readonly database",而只读路径本来就不该改状态。
      2) 探测异常 fail-open(不打崩 ws) —— 探不到时 tree_recent 保持 None,
         plan() 把该页判回 LIVENESS_PROBE_REQUIRED,即"不淘汰";删除方向
         本身已经是 fail-closed。为一次 ssh 抖动让整条 ws 命令失败才是事故。
    """
    if getattr(pg, "read_only", False):
        return {"skipped": "read_only"}
    try:
        return pg.refresh_tree_liveness()
    except Exception as exc:  # noqa: BLE001 - 见 docstring 第 2 条降级语义
        return {"error": type(exc).__name__, "detail": str(exc)[:200]}


def _page_status_may_reuse_sync(args):
    if getattr(args, "page_cmd", None) != "status":
        return False
    if os.environ.get("WS_PAGE_FORCE_SYNC") == "1":
        return False
    return True


def _page_annotation_may_reuse_sync(args):
    if getattr(args, "page_cmd", None) not in {"annotate", "retry-annotation-sync"}:
        return False
    if os.environ.get("WS_PAGE_FORCE_SYNC") == "1":
        return False
    return True


def _page_touch_may_reuse_sync(args):
    return (getattr(args, "page_cmd", None) == "touch"
            and os.environ.get("WS_PAGE_FORCE_SYNC") != "1")


def cmd_page(args):
    if args.page_cmd == "semantic-ingest":
        result = _semantic_cloud_ingest(args.incoming, args.timeout)
        print(json.dumps(result, ensure_ascii=False, indent=2) if args.json else
              "SEMANTIC_CLOUD_SYNC_OK rows=%d" % result["merge"]["rows"])
        return 0
    if args.page_cmd == "alerts":
        pg = pager.WorkspacePager(read_only=True)
    else:
        cache = load_index()
        readonly_status = _page_status_may_reuse_sync(args)
        pg = pager.WorkspacePager(read_only=readonly_status)
        # Cloud verification/snapshot proofs can change between graph rebuilds.
        # Page safety gates must read that authority live instead of reusing a
        # potentially stale Workspace Graph cache.
        assets = [] if readonly_status else pager.load_assets()
    if args.page_cmd == "sync":
        result = pg.sync(cache.get("records", {}), assets, HOST)
        # 见 _refresh_liveness_after_sync:没有这一步,plan() 拿不到文件系统证据,
        # 所有 local_present=1 的页恒判 LIVENESS_PROBE_REQUIRED,候选池永久为空。
        live = _refresh_liveness_after_sync(pg)
        result["liveness"] = live
        result.update({"workspaces": len(cache.get("records", {})), "assets": len(assets)})
        print(json.dumps(result, ensure_ascii=False, indent=2) if args.json else
              "PAGE_SYNC workspaces=%d assets=%d mapped=%d liveness_probed=%s live=%s" % (
                  result["workspaces"], result["assets"], result["mapped"],
                  live.get("probed", "-"), live.get("live", "-")))
        return 0
    if args.page_cmd == "pool":
        result = pg.pool_status()
        print(json.dumps(result, ensure_ascii=False, indent=2) if args.json else
              "PAGE_POOL managed_free=%.4f isolated_free=%.4f evicting=%s migration=%s" % (
                  result["managed"]["free_ratio"], result["isolated"]["free_ratio"],
                  result["managed"]["eviction_active"], result["migration_state"]))
        return 0
    if args.page_cmd == "alerts":
        sample = getattr(args, "disk_sample_json", None)
        if sample is not None:
            stats = pager.disk_stats_from_sample(json.loads(sample), pg.policy)
            result = pg.alerts(disk_stats=stats)
        else:
            result = pg.alerts()
        if args.json:
            print(json.dumps({"alerts": result}, ensure_ascii=False, indent=2))
        else:
            for item in result:
                print("%s\t%s\t%s\t%s" % (
                    item["level"], item["text"], item["detail"], item["code"]))
        return 0
    if args.page_cmd == "eviction-candidates":
        result = pg.eviction_candidates()
        print(json.dumps({"candidates": result}, ensure_ascii=False, indent=2))
        return 0
    if args.page_cmd == "eviction-blocks":
        print(json.dumps({"blocks": pg.eviction_blocks()}, ensure_ascii=False, indent=2))
        return 0
    if args.page_cmd == "evict-unblock":
        hit = pg.unblock_eviction(args.asset_id)
        print("UNBLOCKED %s" % args.asset_id if hit else "NOT_BLOCKED %s" % args.asset_id)
        return 0 if hit else 1
    if args.page_cmd == "archive-blocks":
        print(json.dumps({"blocks": pg.archive_blocks()}, ensure_ascii=False, indent=2))
        return 0
    if args.page_cmd == "archive-unblock":
        hit = pg.unblock_archive(args.workspace_key)
        print("UNBLOCKED %s" % args.workspace_key if hit else "NOT_BLOCKED %s" % args.workspace_key)
        return 0 if hit else 1
    if (_page_status_may_reuse_sync(args) or _page_annotation_may_reuse_sync(args)
            or _page_touch_may_reuse_sync(args)):
        # 只读的 status 复用最近一次全量同步:sync() 会重写全部页行,单次占写锁
        # 30-60s,比 workspace_pager 自己的 busy_timeout(30s) 还长,并发调用方
        # 必然报 "database is locked"(<date> 题库续采单就是这么挂的)。
        pass
    else:
        pg.sync(cache.get("records", {}), assets, HOST)
        # 隐式 sync 也要刷探针:压力淘汰那一拍走的正是这条路径,只挂在显式
        # `ws page sync` 上等于把候选池的生死押在"有人手动敲那条命令"上。
        _refresh_liveness_after_sync(pg)
        _mark_page_synced()
    if args.page_cmd == "status":
        target = args.target
        if target and not target.startswith(("mac|", "hostb|")):
            rec = _resolve_target(cache, target)
            if rec:
                target = pager.WorkspacePager.key(rec["host"], rec["path"])
        result = pg.status(target)
        if args.json:
            print(json.dumps(result, ensure_ascii=False, indent=2))
        else:
            print("Workspace Pager: %d页 HOT=%d WARM=%d COLD=%d PINNED=%d free=%d" % (
                result["count"], result["states"]["HOT"], result["states"]["WARM"],
                result["states"]["COLD"], result["states"]["PINNED"], result["disk"]["free"]))
            for row in result["rows"][:100]:
                print("  %s %-6s %s asset=%s dirty=%s restore=%s" % (
                    row["host"], row["state"], row["path"], row["cloud_asset_id"] or "-",
                    row["dirty"], row["restore_verified"]))
        return 0
    if args.page_cmd == "plan":
        result = pg.plan(args.hot_days, args.cold_days)
        if args.json:
            print(json.dumps({"plan": result}, ensure_ascii=False, indent=2))
        else:
            counts = {}
            for row in result:
                counts[row["action"]] = counts.get(row["action"], 0) + 1
            print("PAGE_PLAN " + " ".join("%s=%d" % x for x in sorted(counts.items())))
            for row in [x for x in result if x["action"] not in ("KEEP_HOT", "COOL_TO_WARM")][:100]:
                print("  %s age=%.1fd %s asset=%s" % (
                    row["action"], row["age_days"], row["path"], row["asset_id"] or "-"))
        return 0
    if args.page_cmd == "classify":
        rec = _resolve_target(cache, args.target)
        if rec:
            host, path = rec["host"], rec["path"]
        else:
            rows = pg.status(args.target)["rows"]
            if len(rows) != 1:
                raise pager.PagerRefused(
                    "REFUSE_CLASSIFY_TARGET_COUNT target=%s count=%d" % (args.target, len(rows)))
            host, path = rows[0]["host"], rows[0]["path"]
        row = pg.set_classification(
            host, path, args.redundancy_class, args.copies, args.reason)
        print(json.dumps(row, ensure_ascii=False, indent=2) if args.json else
              "PAGE_CLASSIFY %s class=%s independent_copies=%d" % (
                  path, row["redundancy_class"], row["independent_copies"]))
        return 0
    if args.page_cmd == "annotate":
        rec = _resolve_target(cache, args.target)
        if rec:
            host, path = rec["host"], rec["path"]
        else:
            rows = pg.status(args.target)["rows"]
            if len(rows) != 1:
                raise pager.PagerRefused(
                    "REFUSE_ANNOTATE_TARGET_COUNT target=%s count=%d" % (
                        args.target, len(rows)))
            host, path = rows[0]["host"], rows[0]["path"]
        # annotate is the worker-facing idempotent entrypoint.  The semantic
        # row is committed before cloud sync, so a transient sync failure
        # leaves SYNC_FAILED with no unannotated content.  Reissuing the same
        # command must retry transport rather than demand a new semantic
        # revision.  A concurrent content write changes the state back to
        # SEMANTIC_STALE, and mark_annotation_sync_complete then fails closed.
        status_rows = pg.status(pager.WorkspacePager.key(host, path))["rows"]
        if len(status_rows) == 1 and status_rows[0]["annotation_status"] == "SYNC_FAILED":
            exported, cloud_result = _semantic_export_and_sync(pg, args.timeout)
            row = pg.mark_annotation_sync_complete(
                host, path, "semantic cloud sync recovered by idempotent annotate")
            print(json.dumps({"page": row, "semantic_rows_exported": exported,
                              "semantic_cloud_sync": cloud_result,
                              "recovered_sync_failure": True},
                             ensure_ascii=False, indent=2) if args.json else
                  "PAGE_SEMANTIC_SYNC_RECOVERED %s revision=%d" % (
                      path, row["semantic_revision"]))
            return 0
        if getattr(args, "resolve_multiple", False):
            # <date> 修:此前这里把 resolve_multiple 直接当 kwarg 传给
            # pg.annotate(), 而 WorkspacePager.annotate() 根本没有这个形参
            # —— 上线以来任何人拨这个开关都是当场 TypeError, 一次都没成功过。
            # (<date> 我报"已加 --resolve-multiple 显式留痕出口"时只改了 CLI 这
            #  一层, 没做端到端验证, 那句话是嘴报; 今天被一个真按合同去用它的
            #  worker 撞出来。)
            # 不改 pager 签名: 它两机 md5 一致, 是语义页的核心机制, 为一个边缘
            # 手工出口去动它风险不对等。改成复用**已经在维护心跳里每拍跑、且
            # 当时真把 MULTIPLE 收回 CURRENT 的**那个 resolver。
            _rm = subprocess.run(
                [sys.executable,
                 os.path.expanduser("~/.coldstore/bin/resolve_semantic_page_multiple.py"),
                 "--host", host, "--path", path, "--actor", args.actor, "--apply"],
                capture_output=True, text=True)
            if _rm.returncode != 0:
                # fail-closed: 收口没成功就不要接着 annotate —— 那只会把一个
                # 没解开的 MULTIPLE 页写上新指纹, 让下一个人更难查。
                print("REFUSE_RESOLVE_MULTIPLE: "
                      + ((_rm.stderr or _rm.stdout or "").strip()[-300:] or "rc=%d" % _rm.returncode),
                      file=sys.stderr)
                return 2
        row = pg.annotate(host, path, args.summary, args.keyword, args.actor,
                          args.task_id)
        try:
            exported, cloud_result = _semantic_export_and_sync(pg, args.timeout)
        except Exception as exc:
            pg.mark_annotation_sync_failed(host, path, str(exc))
            raise
        print(json.dumps({"page": row, "semantic_rows_exported": exported,
                          "semantic_cloud_sync": cloud_result},
                         ensure_ascii=False, indent=2) if args.json else
              "PAGE_ANNOTATE %s revision=%d fingerprint=%s" % (
                  path, row["semantic_revision"], row["content_fingerprint"]))
        return 0
    if args.page_cmd == "retry-annotation-sync":
        rec = _resolve_target(cache, args.target)
        if rec:
            host, path = rec["host"], rec["path"]
        else:
            rows = pg.status(args.target)["rows"]
            if len(rows) != 1:
                raise pager.PagerRefused(
                    "REFUSE_RETRY_SYNC_TARGET_COUNT target=%s count=%d" % (
                        args.target, len(rows)))
            host, path = rows[0]["host"], rows[0]["path"]
        status_rows = pg.status(pager.WorkspacePager.key(host, path))["rows"]
        if len(status_rows) != 1 or status_rows[0]["annotation_status"] != "SYNC_FAILED":
            got = status_rows[0]["annotation_status"] if status_rows else "MISSING"
            raise pager.PagerRefused("REFUSE_PAGE_NOT_SYNC_FAILED status=%s" % got)
        exported, cloud_result = _semantic_export_and_sync(pg, args.timeout)
        row = pg.mark_annotation_sync_complete(host, path)
        print(json.dumps({"page": row, "semantic_rows_exported": exported,
                          "semantic_cloud_sync": cloud_result},
                         ensure_ascii=False, indent=2) if args.json else
              "PAGE_SEMANTIC_SYNC_RECOVERED %s revision=%d" % (
                  path, row["semantic_revision"]))
        return 0
    if args.page_cmd in ("touch", "pin", "unpin"):
        rec = _page_record(cache, args.target, pg=pg)
        if args.page_cmd == "touch":
            row = pg.touch(rec["host"], rec["path"], args.reason, args.lease_hours)
        else:
            row = pg.set_pin(rec["host"], rec["path"], args.page_cmd == "pin", args.reason)
        print(json.dumps(row, ensure_ascii=False, indent=2) if args.json else
              "PAGE_%s %s state=%s" % (args.page_cmd.upper(), rec["path"], row["state"]))
        return 0
    if args.page_cmd in ("preflight", "prepare"):
        if args.file == "-":
            text_body = sys.stdin.read(5 * 1024 * 1024 + 1)
            path = "stdin"
        else:
            path = os.path.abspath(os.path.expanduser(args.file))
            if os.path.getsize(path) > 5 * 1024 * 1024:
                raise pager.PagerRefused("REFUSE_PREFLIGHT_FILE_TOO_LARGE %s" % path)
            text_body = open(path, encoding="utf-8", errors="replace").read()
        if len(text_body.encode("utf-8")) > 5 * 1024 * 1024:
            raise pager.PagerRefused("REFUSE_PREFLIGHT_TEXT_TOO_LARGE %s" % path)
        result = pg.requirements_from_text(text_body, assets)
        for item in result:
            item["local_present"] = _page_path_exists(item["host"], item["original_path"])
            item["needs_restore"] = bool(item["cloud_verified"] and not item["local_present"])
        if args.page_cmd == "prepare":
            for item in result:
                asset = pager.find_asset(assets, item["asset_id"])
                if item["local_present"]:
                    pg.touch(item["host"], item["original_path"], "PAI page preflight hit")
                    item["verdict"] = "PAGE_HIT"
                    continue
                if not item["cloud_verified"]:
                    raise pager.PagerRefused(
                        "REFUSE_REQUIRED_ASSET_NOT_LOCAL_OR_CLOUD %s" % item["asset_id"])
                if HOST != "mac":
                    raise pager.PagerRefused("REFUSE_PREPARE_REQUIRES_MAC_CONTROL_PLANE")
                restored = pager.restore_asset(asset, timeout=args.timeout)
                pg.mark_restore_verified(asset["asset_id"], "PAI preflight restore PASS")
                materialized = _page_finish_materialize(pg, asset, restored)
                item.update({"verdict": "PAGE_IN_PASS", "materialized": materialized})
        print(json.dumps({"requirements": result}, ensure_ascii=False, indent=2))
        return 0
    if args.page_cmd == "archive":
        rec = _page_record(cache, args.target, pg=pg)
        cold_days = args.cold_days
        if cold_days is None:
            cold_days = float(pg.policy.get("cold_days", pg.policy.get("hot_days", 3)))
        cmd = [WORKSPACE_ARCHIVE_TOOL, "--host", rec["host"], "--path", rec["path"],
               "--cold-days", str(cold_days), "--description", args.description]
        page_rows = pg.status(rec["path"])["rows"]
        matching_assets = {
            row["cloud_asset_id"] for row in page_rows
            if row.get("host") == rec["host"] and row.get("path") == rec["path"]
            and row.get("cloud_asset_id")
        }
        if len(matching_assets) == 1:
            cmd.extend(["--label", matching_assets.pop()])
        elif len(matching_assets) > 1:
            raise pager.PagerRefused("REFUSE_PAGE_ARCHIVE_ASSET_AMBIGUOUS")
        if args.execute:
            cmd.append("--execute")
        proc = subprocess.run(cmd, text=True, capture_output=True, timeout=args.timeout)
        if proc.returncode:
            raise pager.PagerRefused(
                "REFUSE_PAGE_ARCHIVE rc=%d detail=%s" %
                (proc.returncode, (proc.stdout + proc.stderr)[-4000:]))
        print(proc.stdout.strip())
        return 0
    if args.page_cmd == "verify":
        asset = pager.find_asset(assets, args.asset_id)
        if HOST != "mac":
            raise pager.PagerRefused("REFUSE_VERIFY_REQUIRES_MAC_CONTROL_PLANE")
        restored = pager.restore_asset(asset, timeout=args.timeout)
        evidence = "output=%s;stream_hashes_and_tar_pass=true" % restored
        pager.record_restore_test(asset["asset_id"], evidence)
        pg.mark_restore_verified(asset["asset_id"], evidence)
        if not args.keep_cache:
            pager.discard_restore_cache(asset["asset_id"])
        print("PAGE_VERIFY_PASS asset=%s cache_retained=%s" %
              (asset["asset_id"], bool(args.keep_cache)))
        return 0
    if args.page_cmd == "enter":
        rec = _page_record(cache, args.target) if args.target else None
        if args.asset_id:
            asset = pager.find_asset(assets, args.asset_id)
        elif rec:
            hits = [a for a in assets if a.get("host") == rec.get("host")
                    and a.get("original_path", "").rstrip("/") == rec["path"].rstrip("/")]
            if len(hits) != 1:
                if _page_path_exists(rec["host"], rec["path"]):
                    row = pg.touch(rec["host"], rec["path"], "ws page enter hit", args.lease_hours)
                    print("PAGE_HIT path=%s state=%s" % (rec["path"], row["state"]))
                    return 0
                raise pager.PagerRefused(
                    "REFUSE_PAGE_ASSET_COUNT path=%s count=%d" % (rec["path"], len(hits)))
            asset = hits[0]
        else:
            raise pager.PagerRefused("REFUSE_ENTER_NEEDS_TARGET_OR_ASSET")
        if _page_path_exists(asset["host"], asset["original_path"]):
            row = pg.touch(asset["host"], asset["original_path"], "ws page enter hit", args.lease_hours)
            print("PAGE_HIT asset=%s path=%s state=%s" % (
                asset["asset_id"], asset["original_path"], row["state"]))
            return 0
        if HOST != "mac":
            raise pager.PagerRefused("REFUSE_RESTORE_REQUIRES_MAC_CONTROL_PLANE")
        restored = pager.restore_asset(asset, timeout=args.timeout)
        pg.mark_restore_verified(asset["asset_id"], "cloud download+decrypt+tar PASS")
        if args.cache_only:
            print("PAGE_RESTORE_PASS asset=%s cache=%s" % (asset["asset_id"], restored))
            return 0
        materialized = _page_finish_materialize(pg, asset, restored)
        print("PAGE_IN_PASS asset=%s path=%s" % (asset["asset_id"], materialized))
        return 0
    raise pager.PagerRefused("REFUSE_UNKNOWN_PAGE_COMMAND %s" % args.page_cmd)


