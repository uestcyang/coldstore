    for rec in recs:
        tag = "" if rec["host"] == HOST else "[%s] " % rec["host"]
        one = rec.get("what") or ("(候选,无HANDOFF: %s)" % rec.get("evidence", "")
                                  if not rec.get("has_handoff") else "(未填这是什么)")
