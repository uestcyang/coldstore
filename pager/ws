    pp.add_argument("--cold-days", type=float, default=None)
    pp.add_argument("--json", action="store_true")
    pp = page_sub.add_parser("pool", help="hostb物理隔离池与主冷热池水位")
    pp.add_argument("--json", action="store_true")
    pp = page_sub.add_parser("alerts", help="仅输出Pager对用户有意义的异常")
    pp.add_argument("--json", action="store_true")
    pp.add_argument("--disk-sample-json", help="复用当前25秒采集轮的双磁盘样本，禁止重复SSH")
    page_sub.add_parser("eviction-candidates", help="按最低温排序输出可淘汰温盘")
    page_sub.add_parser("eviction-blocks", help="执行器明确拒绝(REFUSE_*/NO_ELIGIBLE)而被压力淘汰跳过的资产台账")
