DOMAIN_RULES = (
    ("冷资产", ("冷资产", "cold_asset", "cold-asset", "archive", "vault", "百度云", "baidu")),
    ("示例项目", ("示例项目", "project-a", "示例产线", "示例题库", "示例关键词A", "示例关键词B", "示例关键词C")),
    ("科研", ("agent-g", "dreamer", "research", "论文", "实验", "偏置", "sae", "interpretability",
             "safe-control", "research")),
    ("Agent基础设施", ("/.coldstore", "memory-service", "dispatch", "agent", "bot", "skill", "harness", "pai")),
)


def _infer_domain(rec):
    explicit = (rec.get("domain") or "").strip()
    if explicit and explicit not in ("无", "未分类"):
        return explicit, "explicit"
    hay = " ".join(str(rec.get(k) or "") for k in
                   ("path", "name", "what", "line")).lower()
    for domain, needles in DOMAIN_RULES:
        if any(n.lower() in hay for n in needles):
            return domain, "inferred"
    return "未分类", "unclassified"


def _pipeline_name(rec):
    line = re.sub(r"\s+", " ", (rec.get("line") or "").strip())
    return line if line and line != "无" else "无产线"


def build_workspace_graph(records, assets=None):
    assets = assets or []
    domains = {}
    edges = []
    for key, rec in records.items():
        domain, source = _infer_domain(rec)
        pipeline = _pipeline_name(rec)
        rec["domain"] = domain
        rec["domain_source"] = source
        rec["pipeline"] = pipeline
        d = domains.setdefault(domain, {"count": 0, "explicit": 0, "inferred": 0,
                                        "unclassified": 0, "pipelines": {}})
        d["count"] += 1
        d[source] += 1
        p = d["pipelines"].setdefault(pipeline, {"count": 0, "workspaces": []})
        p["count"] += 1
        p["workspaces"].append(key)
        for dep in rec.get("dependencies") or []:
            edges.append({"from": key, "to_path": dep, "type": "depends_on"})
    # Asset ownership is deterministic: same host + deepest workspace path
    # containing the asset's original path.  Unowned assets remain searchable
    # at graph level instead of being silently dropped.
    for asset in assets:
        original = str(asset.get("original_path") or "").rstrip("/")
        host = asset.get("host")
        candidates = [
            (key, rec) for key, rec in records.items()
            if rec.get("host") == host and rec.get("path")
            and (original == rec["path"].rstrip("/")
                 or original.startswith(rec["path"].rstrip("/") + "/"))
        ]
        if candidates:
            owner, _ = max(candidates, key=lambda x: len(x[1]["path"]))
            edges.append({"from": owner, "to_asset": asset.get("asset_id"),
                          "type": "contains_asset"})
    for d in domains.values():
        for p in d["pipelines"].values():
            p["workspaces"].sort()
    return {"levels": ["domain", "pipeline", "workspace", "asset"],
            "domains": domains, "edges": edges,
            "workspace_count": len(records), "asset_count": len(assets),
            "edge_count": len(edges)}


def refresh_local_record(rec):
    if rec.get("host") != HOST or not rec.get("handoff_path"):
        return rec
    if not os.path.isfile(rec["handoff_path"]):
        return rec
    fresh = build_record_from_file(rec["handoff_path"], HOST)
    fresh["dispatch_refs"] = rec.get("dispatch_refs", 0)
    fresh["dispatch_labels"] = rec.get("dispatch_labels", [])
    return fresh


