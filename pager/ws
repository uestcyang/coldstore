# ============================================================================
# 自检(<date> operator directive)
# 设计铁律:
#   ① 全部跑在 /tmp 下,绝不碰 ~ 下任何真实 HANDOFF.md / workspaces.json
#   ② 通过短路 CACHE_FILE 全局变量(模块级函数运行时取)避免触碰真实缓存
#   ③ 不许改任何现有子命令行为/输出(自检是加法,仅 subprocess 调起 ws 触发)
# 覆盖的不变量(对应 spec 列出的判据):
#   ① ws new 不覆盖已有 HANDOFF.md,字节数一字不变,exit 2
#   ② ws new 产出过 lint(同源同进程,生成器-体检器零漂移)
#   ③ ws log 只追加,前缀保持,可被 DATE_RE + has_chain 识别
#   ④ ws skill --add 去重 + 永不删除(⭐必留)
#   ⑤ ≥5 并发 ws log:条目数恰等于进程数,文件不撕裂(flock 真测)
#   ⑥ 对侧不可达时 ws find 降级为只用本机索引,绝不整体失败
# 输出 JSON:`{ok, assertions, failed:[...], concurrent_ok}`
# ============================================================================

def cmd_selftest(json_out=False):
    """ws --selftest:跑在 /tmp 下的全隔离自检。返回 0=全过,1=有失败。"""
    import concurrent.futures as _cf
    import shutil
    import contextlib
    import io

    # ---- 临时目录 & 真实缓存 mtime 快照 ----
    real_cache_path = CACHE_FILE
    real_cache_existed = os.path.exists(real_cache_path)
    real_cache_mtime = os.path.getmtime(real_cache_path) if real_cache_existed else None
    real_cache_size = os.path.getsize(real_cache_path) if real_cache_existed else None

    base = "/tmp/ws_selftest_%d_%d" % (os.getpid(), int(time.time()))
    os.makedirs(base, exist_ok=False)

    # 把 handoff_lint 注入,拿到与 ws 完全同一套判据(无漂移)
    _hl_dir = os.path.dirname(LINT_PATH)
    if _hl_dir not in sys.path:
        sys.path.insert(0, _hl_dir)
    import handoff_lint as _hl

    failures = []
    n_assert = 0
    concurrent_ok = False

    def _check(cond, msg):
        nonlocal n_assert
        n_assert += 1
        if not cond:
            failures.append(msg)

    WS_BIN = os.path.abspath(__file__)

    def _run_ws(*args, timeout=30):
        env = dict(os.environ, WS_SELFTEST="1")
        return subprocess.run([sys.executable, WS_BIN] + list(args),
                              capture_output=True, text=True, timeout=timeout, env=env)

    # ---- 工作区目录句柄(给最后清理用,出错也保证存在) ----
    dir_jobs = []

    # ============ 写路径 ============

    # ① ws new 对已有 HANDOFF.md 绝不覆盖,exit 2,字节数一字不变
    d_a = os.path.join(base, "a_overwrite")
    dir_jobs.append(d_a)
    try:
        os.makedirs(d_a, exist_ok=False)
        hp_a = os.path.join(d_a, "HANDOFF.md")
        with open(hp_a, "w", encoding="utf-8") as f:
            f.write("# original\nprotected sample\nnot to be touched\n")
        original = open(hp_a, "rb").read()
        r = _run_ws("new", d_a, "--what", "x", "--line", "x")
        post = open(hp_a, "rb").read()
        _check(r.returncode == 2,
               "① ws new 已存在应 exit 2 实得 %d; stderr=%s" % (r.returncode, r.stderr[:200]))
        _check(original == post, "① 已存在 HANDOFF.md 字节被改动")
    except Exception as e:
        _check(False, "① 异常: %s" % e)

    # ② ws new 生成的通稿必过 lint(同源判据,零漂移)
    d_b = os.path.join(base, "b_new_lint")
    dir_jobs.append(d_b)
    try:
        os.makedirs(d_b, exist_ok=False)
        r = _run_ws("new", d_b, "--what", "selftest", "--line", "selftest")
        _check(r.returncode == 0, "② ws new 应 exit 0 实得 %d stderr=%s"
               % (r.returncode, r.stderr[:200]))
        hp_b = os.path.join(d_b, "HANDOFF.md")
        defects = _hl.check_handoff(hp_b)
        _check(defects == [], "② ws new 产出过不了 lint: %s" % defects[:3])
    except Exception as e:
        _check(False, "② 异常: %s" % e)

    # ③ ws log 只追加(全文前缀比对),追加行可被 DATE_RE + has_chain 识别
    d_c = os.path.join(base, "c_log_append")
    dir_jobs.append(d_c)
    try:
        os.makedirs(d_c, exist_ok=False)
        r0 = _run_ws("new", d_c, "--what", "", "--line", "selftest")
        _check(r0.returncode == 0, "③ 准备 ws new 失败: rc=%d" % r0.returncode)
        hp_c = os.path.join(d_c, "HANDOFF.md")
        before = open(hp_c, encoding="utf-8").read()
        r = _run_ws("log", d_c, "--chain", "agent-f-worker-llm",
                    "--what", "日志追加自检", "--why", "selftest")
        _check(r.returncode == 0, "③ ws log 应 exit 0 实得 %d stderr=%s"
               % (r.returncode, r.stderr[:200]))
        after = open(hp_c, encoding="utf-8").read()
        _check(after.startswith(before), "③ ws log 不应改动既有内容(前缀不一致)")
        tail = after[len(before):]
        appended_lines = [ln for ln in tail.splitlines() if ln.strip()]
        _check(any(_hl.DATE_RE.search(ln[:30]) and _hl.has_chain(ln)
                   for ln in appended_lines),
               "③ 追加行必须可被 DATE_RE+has_chain 识别; got 头两行: %s"
               % appended_lines[:2])
        rs = _run_ws("state", d_c, "--chain", "agent-f-worker-llm",
                     "--progress", "自检任务已完成", "--next-gate", "无",
                     "--what", "自检工作区", "--blocker", "无")
        _check(rs.returncode == 0, "③b ws state 应 exit 0 实得 %d stderr=%s"
               % (rs.returncode, rs.stderr[:200]))
        parsed_c = parse_handoff_text(open(hp_c, encoding="utf-8").read())["fields"]
        _check(parsed_c["what"] == "自检工作区" and
               parsed_c["progress"] == "自检任务已完成" and parsed_c["next_gate"] == "无",
               "③b ws state 应补齐真空现态: %s" % parsed_c)
        body_c = open(hp_c, encoding="utf-8").read()
        _check(body_c.count("- 最近任务:") == 1,
               "③b ws state 应维护唯一最近任务游标")
        rs2 = _run_ws("state", d_c, "--chain", "agent-f-worker-llm",
                      "--progress", "第二任务完成", "--next-gate", "复核",
                      "--blocker", "无")
        parsed_c2 = parse_handoff_text(open(hp_c, encoding="utf-8").read())["fields"]
