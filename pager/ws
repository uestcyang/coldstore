        os.path.join(home, ".codex"),
        os.path.join(home, ".coldstore", "_deleted"),
        os.path.join(home, ".coldstore", "cron"),
        os.path.join(home, ".coldstore", "plugins"),
        os.path.join(home, ".coldstore", "profiles"),
        os.path.join(home, ".coldstore", "skills"),
        os.path.join(home, ".coldstore", "tasks"),
        os.path.join(home, "skills-core-baks"),
    )
    exact = (os.path.join(home, "agent-j"), os.path.join(home, "agent-h"))
    rel_parts = os.path.relpath(path, home).split(os.sep)
    venv_like = any(
        part == "venv" or part.startswith(".venv")
        or part.endswith(("-venv", "_venv"))
        for part in rel_parts
    )
    return (_is_snapshot_workspace(path) or venv_like or path in exact
            or any(path == root or path.startswith(root + os.sep) for root in roots))


def _is_snapshot_workspace(path):
    """Reuse lint's ancestor rule; copies never become live routing targets.

    Pure path check also applies to remote/cached records without remote reads.
    The backup manager itself remains a valid workspace.
    """
    from handoff_lint import SNAPSHOT_DIR_RE
    root = os.path.normpath(path)
    if os.path.basename(root) == 'HANDOFF.md':
        root = os.path.dirname(root)
    return any(SNAPSHOT_DIR_RE.search(part)
               for part in os.path.dirname(root).split(os.sep))


