                    help="输出 JSON 报告 {ok, assertions, failed, concurrent_ok}")
    return p


def main():
    argv = sys.argv[1:]
    if argv and argv[0] == "lint":
        os.execvp(sys.executable, [sys.executable, LINT_PATH] + argv[1:])
        return 0  # unreachable
    # <date>:接受 `ws --selftest [--json]` 形式(短路在 argparse 之前,免去
    # 与 subparser 互斥的麻烦;`ws selftest` 仍走下面常规分支)
    if "--selftest" in argv:
        json_out = "--json" in argv
        argv = [a for a in argv if a not in ("--selftest", "--json")]
        return cmd_selftest(json_out=json_out)
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.cmd == "find":
        return cmd_find(args.keywords)
    if args.cmd == "list":
        return cmd_list()
    if args.cmd == "map":
        return cmd_map(args.keywords, args.json, max(1, min(args.limit, 100)))
    if args.cmd == "route":
        return cmd_route(args.keywords, args.json, max(1, min(args.limit, 100)))
    if args.cmd == "show":
        return cmd_show(args.target)
    if args.cmd == "new":
        return cmd_new(args.path, args.name, args.what, args.line)
    if args.cmd == "log":
        return cmd_log(args.path, args.chain, args.what, args.why)
    if args.cmd == "state":
        return cmd_state(args.path, args.chain, args.progress, args.next_gate,
                         args.blocker, args.what)
    if args.cmd == "dep":
        return cmd_dep(args.path, args.add, args.chain)
    if args.cmd == "skill":
        return cmd_skill(args.path, args.add, args.star, args.note)
    if args.cmd == "fix":
        return cmd_fix(args.path, args.force)
    if args.cmd == "check":
        return cmd_check(args.path)
    if args.cmd == "index":
        return cmd_index(args.rebuild)
    if args.cmd == "who":
        return cmd_who(args.path)
    if args.cmd == "brief":
        return cmd_brief(args.path, args.window, args.json, args.me, args.no_peer)
    if args.cmd == "page":
        return cmd_page(args)
    if args.cmd == "selftest":
        return cmd_selftest(json_out=args.json)
    parser.print_help()
    return 1


