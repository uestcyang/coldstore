    if IS_MAC and path.startswith("/home/"):
        return ("跨机路径:%s 属于 hostb,Mac 不能建区/记账。请在 hostb 上跑:\n"
                "  ssh %s '~/.coldstore/bin/ws ...'" % (path, PEER_SSH))
    if (not IS_MAC) and path.startswith("/Users/"):
        return ("跨机路径:%s 属于 Mac,hostb 不能建区/记账。请在 Mac 上跑:\n"
                "  ssh %s '~/.coldstore/bin/ws ...'" % (path, PEER_SSH))
    return None


def cmd_new(path, name, what, line):
