def build_parser():
    p = argparse.ArgumentParser(prog="ws", description="工作区索引 CLI —— 规范见 skill `workspace-handoff`")
    sub = p.add_subparsers(dest="cmd")

    sp = sub.add_parser("find", help="按关键词匹配工作区")
    sp.add_argument("keywords", nargs="+")

    sub.add_parser("list", help="全量索引一览")

    sp = sub.add_parser("map", help="多级总览:领域→产线→工作区")
    sp.add_argument("keywords", nargs="*")
    sp.add_argument("--json", action="store_true")
    sp.add_argument("--limit", type=int, default=12, help="每领域最多展示的产线数")

    sp = sub.add_parser("route", help="按需求路由到候选工作区并给出下钻命令")
    sp.add_argument("keywords", nargs="+")
    sp.add_argument("--json", action="store_true")
    sp.add_argument("--limit", type=int, default=10)

    sp = sub.add_parser("show", help="打印工作区当前态+必用skill")
    sp.add_argument("target")

    sp = sub.add_parser("new", help="建区(已有 HANDOFF.md 绝不覆盖)")
    sp.add_argument("path")
    sp.add_argument("--name")
    sp.add_argument("--what", default="")
    sp.add_argument("--line", default="")

    sp = sub.add_parser("log", help="修改日志追加一行")
    sp.add_argument("path")
    sp.add_argument("--chain", required=True)
    sp.add_argument("--what", required=True)
    sp.add_argument("--why", required=True)

    sp = sub.add_parser("state", help="原子刷新当前任务游标(补真空现态,不覆盖已有富文本)")
    sp.add_argument("path")
    sp.add_argument("--chain", required=True)
    sp.add_argument("--progress", required=True)
