    return []


def _capability_fts_units(query):
    units = []
    for chunk in re.findall(r"[a-z0-9_.+-]{3,}|[\u3400-\u9fff]{3,}", query.casefold()):
        if re.fullmatch(r"[\u3400-\u9fff]+", chunk):
            units.extend(chunk[i:i + 3] for i in range(max(1, len(chunk) - 2)))
        else:
            units.append(chunk)
    return list(dict.fromkeys(units))[:48]


def _file_sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _local_capability_fts_search(query, limit=10):
    units = _capability_fts_units(query)
    if not units:
        return None
    match = " OR ".join('"%s"' % x.replace('"', '""') for x in units)
    for path in CAPABILITY_INDEX_PATHS:
        if not os.path.isfile(path):
            continue
        try:
            uri = "file:%s?mode=ro" % path
            with contextlib.closing(sqlite3.connect(uri, uri=True, timeout=2)) as conn:
                conn.row_factory = sqlite3.Row
                meta = {r[0]: json.loads(r[1]) for r in
                        conn.execute("SELECT key,value_json FROM meta")}
                manifest_path = os.path.join(
                    os.path.dirname(path), CAPABILITY_ROUTER_MANIFEST_NAME
                )
                with open(manifest_path, encoding="utf-8") as manifest_handle:
                    manifest = json.load(manifest_handle)
                if (manifest.get("engine") != CAPABILITY_ROUTER_ENGINE
                        or manifest.get("package_version") !=
                        CAPABILITY_ROUTER_PACKAGE_VERSION
                        or manifest.get("source_commit") !=
                        CAPABILITY_ROUTER_SOURCE_COMMIT
                        or manifest.get("wheel_sha256") !=
                        CAPABILITY_ROUTER_WHEEL_SHA256
                        or manifest.get("litellm_security_floor") !=
                        CAPABILITY_ROUTER_LITELLM_FLOOR
                        or manifest.get("litellm_locked_version") !=
                        CAPABILITY_ROUTER_LITELLM_VERSION
                        or manifest.get("offline_cost_map_enforced") is not True
                        or float(manifest.get("score_threshold") or -1) !=
                        CAPABILITY_ROUTER_SCORE_THRESHOLD
                        or manifest.get("aggregation") !=
                        CAPABILITY_ROUTER_AGGREGATION
                        or int(manifest.get("retrieval_contract_version") or 0) !=
                        CAPABILITY_RETRIEVAL_CONTRACT_VERSION
                        or meta.get("router_engine") != CAPABILITY_ROUTER_ENGINE
                        or meta.get("router_package_version") !=
                        CAPABILITY_ROUTER_PACKAGE_VERSION
                        or manifest.get("cards_sha256") != meta.get("cards_sha256")
                        or int(manifest.get("card_count") or 0) !=
                        int(meta.get("card_count") or 0)
                        or manifest.get("utterances_sha256") !=
                        meta.get("router_utterances_sha256")
                        or int(manifest.get("utterance_count") or 0) !=
                        int(meta.get("router_utterance_count") or 0)
                        or manifest.get("cpu_only_enforced") is not True
                        or meta.get("embedding_device") != "cpu"
                        or int(meta.get("embedding_vram_mib") or 0) != 0
                        or manifest.get("index_sha256") != _file_sha256(path)):
                    continue
                rows = conn.execute(
                    "SELECT c.card_json,bm25(capability_fts) AS fts_score "
                    "FROM capability_fts JOIN capabilities AS c "
                    "ON c.rowid=capability_fts.rowid "
                    "WHERE capability_fts MATCH ? ORDER BY fts_score LIMIT ?",
                    (match, int(limit)),
                ).fetchall()
            matches = []
            for rank, row in enumerate(rows, 1):
                card = json.loads(row["card_json"])
                matches.append({
                    "card_id": card["card_id"], "tool_id": card["tool_id"],
                    "capability_id": card["capability_id"], "title": card["title"],
                    "intent": card["intent"], "aliases": card["aliases"],
                    "scenarios": card["scenarios"],
                    "anti_scenarios": card["anti_scenarios"],
                    "callable": card["callable"], "status": card["status"],
                    "tier": card["tier"], "entrypoints": card["entrypoints"],
                    "workspace_paths": card["workspace_paths"],
                    "evidence": card["evidence"], "fts_rank": rank,
                    "fts_bm25": float(row["fts_score"]),
                })
            return {"ok": True, "mode": "fts-fallback",
                    "engine": CAPABILITY_ROUTER_ENGINE,
                    "package_version": CAPABILITY_ROUTER_PACKAGE_VERSION,
                    "semantic_status": "remote_unavailable_local_fts",
                    "embedding_model": meta.get("embedding_model"),
                    "embedding_device": meta.get("embedding_device"),
                    "matches": matches, "source": path}
        except (OSError, sqlite3.Error, json.JSONDecodeError, KeyError, TypeError):
            continue
    return None


def capability_search(query, limit=10):
    argv = [CAPABILITY_REMOTE_SCRIPT, "--search", query, "--mode", "semantic-router",
            "--limit", str(int(limit)), "--index", CAPABILITY_REMOTE_INDEX]
    try:
        if HOST == "mac":
            remote = " ".join(shlex.quote(x) for x in argv)
            proc = subprocess.run(
                ["ssh", "-o", "ConnectTimeout=2", "-o", "BatchMode=yes",
                 "user@host-b", remote],
                text=True, capture_output=True, timeout=CAPABILITY_QUERY_TIMEOUT_SEC,
            )
        else:
            proc = subprocess.run(
                argv, text=True, capture_output=True,
                timeout=CAPABILITY_QUERY_TIMEOUT_SEC,
            )
        if proc.returncode == 0:
            value = json.loads(proc.stdout)
            if value.get("ok") is True and isinstance(value.get("matches"), list):
                value["source"] = "hostb_semantic_router"
                return value
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError, TypeError):
        pass
    return _local_capability_fts_search(query, limit)


def local_handoff_paths():
    """返回 None 表示本次 find 失败/超时(磁盘忙等),调用方应回退用旧缓存兜底,
    绝不能把 None 当"真的一个 HANDOFF.md 都没有"处理,否则整机记录会被冲空。"""
    try:
        r = subprocess.run(["bash", "-c", FIND_CMD], capture_output=True, text=True,
                           timeout=LOCAL_FIND_TIMEOUT)
        return [l for l in r.stdout.splitlines()
                if l.strip() and not _is_nonworkspace_handoff(l)]
    except Exception as e:
        print("警告: 本机 find HANDOFF.md 失败/超时(%s),本次索引本机部分回退用旧缓存" % e,
              file=sys.stderr)
        return None


def _parse_remote_dump(out):
    entries = []
    for b in out.split("===WS_FILE===\n")[1:]:
        try:
            path_part, rest = b.split("===WS_MTIME===\n", 1)
            mtime_part, rest2 = rest.split("===WS_BODY===\n", 1)
            body = rest2.split("===WS_END===", 1)[0]
            path = path_part.strip()
            mtime = float((mtime_part.strip() or "0").splitlines()[0] or 0)
            entries.append((path, body, mtime))
        except Exception:
            continue
    return entries


def _filter_remote_entries(entries, peer_home):
    """远端 find 命令含本机展开的绝对剪枝路径，回传后必须按远端 HOME 再过滤。"""
    return [entry for entry in entries
            if not _is_nonworkspace_handoff(entry[0], home=peer_home)]


def remote_handoff_dump():
    """返回 [(handoff_path, content, mtime), ...] 或 None(对侧不可达,降级)。"""
    remote_script = (
        FIND_CMD + ' | while IFS= read -r f; do '
        'echo "===WS_FILE==="; echo "$f"; '
        'echo "===WS_MTIME==="; (stat -c %Y "$f" 2>/dev/null || stat -f %m "$f" 2>/dev/null); '
        'echo "===WS_BODY==="; cat "$f"; echo "===WS_END==="; done'
    )
    try:
        r = subprocess.run(
            ["ssh", "-o", "ConnectTimeout=6", "-o", "BatchMode=yes", PEER_SSH,
             "bash -lc %s" % shlex.quote(remote_script)],
            capture_output=True, text=True, timeout=REMOTE_FIND_TIMEOUT)
    except Exception:
        return None
    if r.returncode != 0 and not r.stdout.strip():
        return None
    return _filter_remote_entries(_parse_remote_dump(r.stdout), PEER_HOME)


def fetch_remote_file(path):
    try:
        r = subprocess.run(
            ["ssh", "-o", "ConnectTimeout=6", "-o", "BatchMode=yes", PEER_SSH,
             "cat %s" % shlex.quote(path)],
            capture_output=True, text=True, timeout=15)
    except Exception:
        return None
    if r.returncode != 0:
        return None
    return r.stdout


def lint_missing_local():
    try:
        r = subprocess.run(["python3", LINT_PATH, "--json"], capture_output=True,
                           text=True, timeout=90)
        data = json.loads(r.stdout)
        return data.get("missing", [])
    except Exception:
        return []


def dispatch_refs():
    """path -> {count, labels, tasks},来源同 handoff_lint.py 的判据③。

    count 按不同派单计,不按同一 prompt 里的出现次数计。tasks 保留任务身份,
    后面把多个“文件/产物路径”归并到同一工作区根时用集合去重,避免一单里
    列了 20 个 results.json 就被误算成“20 个不同派单引用”。
    """
    counts = {}
    pat = re.compile(r"(?:/Users/[A-Za-z0-9_.-]+|/home/[A-Za-z0-9_.-]+|~)"
                     r"/[A-Za-z0-9_.一-鿿-]+(?:/[A-Za-z0-9_.一-鿿-]+)*")
    for state in ("done", "failed"):
        d = os.path.join(DISPATCH, state)
        if not os.path.isdir(d):
            continue
        try:
            tids = os.listdir(d)
        except OSError:
            continue
        for tid in tids:
            p = os.path.join(d, tid, "prompt.md")
            if not os.path.isfile(p):
                continue
            try:
                txt = open(p, encoding="utf-8", errors="ignore").read()
            except OSError:
                continue
            label = ""
            tj = os.path.join(d, tid, "task.json")
            if os.path.isfile(tj):
                try:
                    label = json.load(open(tj)).get("label", "")
                except Exception:
                    pass
            seen = set()
            for m in pat.findall(txt):
                if m.startswith("~"):
                    m = HOME + m[1:]
                seen.add(m)
            for m in seen:
                rec = counts.setdefault(m, {"count": 0, "labels": set(), "tasks": set()})
                rec["tasks"].add("%s/%s" % (state, tid))
                rec["count"] = len(rec["tasks"])
                if label:
                    rec["labels"].add(label)
    return counts


# dispatch prompt 里的路径是“任务证据”,不是“工作区声明”。历史实测中
# results.json / report.md / .venv/bin/python / *.pt 因被 >=2 单引用,全部被提升为
# 裸候选工作区。下面只做“归属”:
#   1) 最深的已知 HANDOFF/lint 工作区根;
#   2) 本机确有项目标记的仓库根(用于发现尚未建 HANDOFF 的新项目)。
# 绝不把文件、runs/models/data 子目录或对侧未核实路径单独晋升。
PROJECT_MARKERS = (
    ".git", "pyproject.toml", "package.json", "pubspec.yaml", "Cargo.toml",
    "go.mod", "setup.py", "setup.cfg", "AGENTS.md",
)


def _dispatch_path_host(path):
    if path.startswith("/Users/"):
        return "mac"
    if path.startswith("/home/"):
        return "hostb"
    return HOST


def _deepest_workspace_root(path, host, records):
    roots = sorted((r["path"].rstrip("/") for r in records
                    if r.get("host") == host and r.get("path")), key=len, reverse=True)
    for root in roots:
        if path == root or path.startswith(root + "/"):
            return root
    return None


def _local_project_root(path, home=None):
    """Conservative local-only promotion: return a real marked project root or None.

    `home` is injectable solely for the isolated selftest. Production always uses HOME.
    Hidden/system roots are never discovered from prompt text; if they are real workspaces,
    an existing HANDOFF/lint record remains authoritative.
    """
    home = os.path.abspath(home or HOME).rstrip("/")
    path = os.path.abspath(path)
    if not (path == home or path.startswith(home + "/")):
        return None
    rel = path[len(home):].lstrip("/")
    if not rel:
        return None
    # 项目标记只证明“是代码仓库”，不证明“是长期协作工作区”。已知的上游依赖、
    # 运行态和退役根必须先经过同一排除谓词，否则 prompt 引用两次就会重新晋升。
    if _is_nonworkspace_handoff(path, home=home):
        return None
    first = rel.split("/", 1)[0]
    if first.startswith(".") or first in PRUNE_NAMES:
        return None

    probe = path if os.path.isdir(path) else os.path.dirname(path)
    # 旧 prompt 可能指向已移走的产物;只向上找仍存在的项目根,不会重建/删除任何东西。
    while probe.startswith(home + "/"):
        if os.path.isdir(probe) and any(os.path.exists(os.path.join(probe, m))
                                        for m in PROJECT_MARKERS):
            return probe
        parent = os.path.dirname(probe)
        if parent == probe:
            break
        probe = parent
    return None


def _aggregate_dispatch_targets(refs, records, local_home=None):
    """Canonical target -> distinct tasks/labels, plus diagnostics; pure except local stat."""
    grouped = {}
    unresolved = 0
    attributed_raw = 0
    for path, info in refs.items():
        host = _dispatch_path_host(path)
        root = _deepest_workspace_root(path, host, records)
        if root is None and host == HOST:
            root = _local_project_root(path, home=local_home)
        if root is None:
            unresolved += 1
            continue
        attributed_raw += 1
        key = (host, root)
        g = grouped.setdefault(key, {"tasks": set(), "labels": set(), "raw_paths": set()})
        g["tasks"].update(info.get("tasks") or ())
        # 兼容旧/测试调用者只给 count 的形态;生产 dispatch_refs 总有 tasks。
        if not info.get("tasks"):
            g["tasks"].update("legacy:%s:%d" % (path, i)
                              for i in range(int(info.get("count", 0))))
        g["labels"].update(info.get("labels") or ())
        g["raw_paths"].add(path)
    return grouped, {
        "raw_paths": len(refs),
        "attributed_raw_paths": attributed_raw,
        "unresolved_raw_paths": unresolved,
        "canonical_targets": len(grouped),
    }


def _prior_cache_records():
    try:
        return json.load(open(CACHE_FILE, encoding="utf-8")).get("records", {})
    except Exception:
        return {}


def build_index(force=True):
    now = time.time()
    local_paths = local_handoff_paths()
    local_records = {}
    if local_paths is None:
        # 本机 find 超时/失败:回退用上一次缓存里本机的记录兜底,不清空。
        for k, v in _prior_cache_records().items():
            if v.get("host") == HOST:
                h, p = k.split("|", 1)
                local_records[(h, p)] = v
    else:
        for hp in local_paths:
            rec = build_record_from_file(hp, HOST)
            local_records[(HOST, rec["path"])] = rec

    remote_records = {}
    dump = remote_handoff_dump()
    remote_ok = dump is not None
    if dump is not None:
        for hp, content, mtime in dump:
            rec = build_record_from_text(hp, content, mtime, PEER_HOST)
            remote_records[(PEER_HOST, rec["path"])] = rec
    else:
        # 对侧不可达/超时:回退用上一次缓存里对侧的记录兜底,标记为可能过期,不清空。
        for k, v in _prior_cache_records().items():
            if v.get("host") == PEER_HOST:
                h, p = k.split("|", 1)
                remote_records[(h, p)] = v

    for m in lint_missing_local():
        key = (HOST, m["path"])
        if key not in local_records:
            local_records[key] = make_bare_record(
                m["path"], HOST, evidence=m.get("evidence", ""),
                priority=m.get("priority", "P1"))

    refs = dispatch_refs()
    all_current = list(local_records.values()) + list(remote_records.values())
    grouped_refs, dispatch_stats = _aggregate_dispatch_targets(refs, all_current)
    promoted = 0
    for (host, root), info in grouped_refs.items():
        nrefs = len(info["tasks"])
        if nrefs < 2:
            continue
        key = (host, root)
        target = local_records if host == HOST else remote_records
        if key in target:
            target[key]["dispatch_refs"] = max(target[key].get("dispatch_refs", 0), nrefs)
            target[key]["dispatch_labels"] = sorted(
                set(target[key].get("dispatch_labels", [])) | info["labels"])
        elif host == HOST:
            # _aggregate_dispatch_targets 只会把“本机存在且带项目标记”
            # 的根交到这里;文件/产物目录/对侧未验路径根本进不来。
            local_records[key] = make_bare_record(
                root, host, evidence="dispatch任务归属x%d(已验项目根)" % nrefs,
                dispatch_refs=nrefs, dispatch_labels=sorted(info["labels"]))
            promoted += 1

    dispatch_stats["promoted_bare_roots"] = promoted

    # Function Foundry has deliberate storage tiers rather than one HANDOFF in
    # every CAS/quarantine directory.  Its signed exporter is the directory
    # authority; expose those roots as graph/page nodes without inventing prose.
    for item in load_function_storage():
        host, path = item.get("host"), item.get("path")
        if host not in (HOST, PEER_HOST) or not path:
            continue
        target = local_records if host == HOST else remote_records
        rec = make_bare_record(path, host,
                               evidence="Function Foundry %s exporter" % item.get("tier"))
        rec.update({"what": item.get("description", "Function Foundry storage"),
                    "domain": "Agent基础设施", "pipeline": "Function Foundry",
                    "domain_source": "declared", "mtime": item.get("mtime")})
        target[(host, path)] = rec

    records = {}
    for (h, p), v in list(local_records.items()) + list(remote_records.items()):
        records["%s|%s" % (h, p)] = v

    assets = pager.load_assets()
    cache = {"schema_version": INDEX_SCHEMA_VERSION,
             "built_at": now, "host": HOST, "remote_reachable": remote_ok,
             "dispatch_path_stats": dispatch_stats, "records": records,
             "assets": assets}
    cache = public_index(cache)
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = CACHE_FILE + ".tmp.%d" % os.getpid()
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cache, f, ensure_ascii=False, indent=1)
    os.replace(tmp, CACHE_FILE)
    try:
        pager.WorkspacePager().sync(records, assets, HOST)
    except Exception as exc:
        # The deterministic directory remains usable if the page database is
        # temporarily locked; page commands themselves fail closed.
        print("警告:页表同步失败:%s" % exc, file=sys.stderr)
    return cache


def _cache_status(cache):
    now = time.time()
    built_at = float(cache.get("built_at") or 0)
    try:
        file_mtime = float(os.path.getmtime(CACHE_FILE))
    except OSError:
        file_mtime = 0.0
    invalidated = file_mtime <= 1.0
    built_age = max(0.0, now - built_at)
    file_age = max(0.0, now - file_mtime) if not invalidated else built_age
    age_sec = max(built_age, file_age)
    return {
        "stale": invalidated or age_sec >= CACHE_TTL_SEC,
        "invalidated": invalidated,
        "age_sec": round(age_sec, 3),
        "ttl_sec": CACHE_TTL_SEC,
        "served_last_valid": True,
        "refresh_command": "ws index --rebuild",
    }


def _valid_index_cache(cache):
    return (
        isinstance(cache, dict)
        and cache.get("schema_version") == INDEX_SCHEMA_VERSION
        and isinstance(cache.get("graph"), dict)
        and isinstance(cache.get("records"), dict)
        and isinstance(cache.get("assets", []), list)
        and isinstance(cache.get("built_at"), (int, float))
        and not isinstance(cache.get("built_at"), bool)
    )


def public_index(cache):
    from shared_context_policy import blocked_context, public_text
    def clean(value):
        if isinstance(value, str):
            return public_text(value)
        if isinstance(value, dict):
            return {key: clean(item) for key, item in value.items()}
        if isinstance(value, list):
            return [clean(item) for item in value]
        return value
    result = clean(cache)
    result['records'] = {key: clean(record) for key, record in cache['records'].items()
                         if not blocked_context(key, record.get('path'))
                         and not _is_snapshot_workspace(record.get('path') or key)}
    result['assets'] = [clean(asset) for asset in cache.get('assets', [])
                        if not blocked_context(asset.get('asset_id'), asset.get('original_path'))]
    result['graph'] = build_workspace_graph(result['records'], result['assets'])
    return result


def load_index():
    """Return the last valid cache immediately; never rebuild from a query."""
    try:
        with open(CACHE_FILE, encoding="utf-8") as handle:
            cache = json.load(handle)
    except (OSError, json.JSONDecodeError) as exc:
        raise pager.PagerRefused(
            "REFUSE_WORKSPACE_INDEX_UNAVAILABLE run='ws index --rebuild' error=%s" % exc
        )
    if not _valid_index_cache(cache):
        raise pager.PagerRefused(
            "REFUSE_WORKSPACE_INDEX_INVALID run='ws index --rebuild'"
        )
    cache = dict(cache)
    cache.setdefault("assets", [])
    cache["cache_status"] = _cache_status(cache)
    return public_index(cache)


def _report_cache_status(cache):
    status = cache.get("cache_status") or _cache_status(cache)
    if status.get("stale"):
        print(
            "CACHE_STALE age_sec=%s serving=last_valid refresh='ws index --rebuild'"
            % status.get("age_sec"), file=sys.stderr,
        )


def _invalidate_index(changed_path):
    """写后只把缓存标 stale；显式维护重建前查询继续读最后合法版本。"""
    try:
        real = os.path.realpath(changed_path)
        if real.startswith(("/tmp/", "/private/tmp/")) or not os.path.exists(CACHE_FILE):
            return
        os.utime(CACHE_FILE, (0, 0))
    except OSError:
        pass                         # 缓存失效失败不应让权威 HANDOFF 写入失败


# ============================================================================
# Workspace Graph —— memory-service 的确定性目录平面。
# 显式 `领域:` 字段永远优先；旧通稿没有该字段时只做可解释推断，并把 source=inferred
# 写进索引，绝不把启发式分类冒充人工事实。无法可靠判断的归「未分类」。
