def _route_score(rec, keywords):
    """字段加权的确定性路由；只做字符串匹配，不伪装成语义检索。"""
    weighted = (("domain", 12), ("pipeline", 10), ("line", 9), ("name", 8),
                ("path", 7), ("what", 6), ("progress", 3), ("next_gate", 2),
                ("blocker", 1))
    score, matched = 0, []
    for kw in keywords:
        got = False
        for field, weight in weighted:
            if kw in str(rec.get(field) or "").lower():
                score += weight
                got = True
        skill_hay = " ".join(s.get("name", "") for s in rec.get("skills", [])).lower()
        if kw in skill_hay:
            score += 5
            got = True
        if not got and kw in recent_task_text(rec).lower():
            score += 1
            got = True
        if got:
            matched.append(kw)
    # 多词全命中优先，避免只擦中一个泛词的目录霸榜。
    if keywords and len(matched) == len(keywords):
        score += 20
    return score, matched


def _route_records(cache, keyword_args, limit=10):
    kws = []
    for a in keyword_args:
        kws.extend(a.lower().split())
    kws = [k for k in kws if k]
    scored = []
    for key, rec in cache.get("records", {}).items():
        score, matched = _route_score(rec, kws)
        if score:
            scored.append((score, key, rec, matched))
    scored.sort(key=lambda x: (-x[0], x[2].get("domain", ""),
                               x[2].get("pipeline", ""), x[2].get("path", "")))
    return scored[:limit]


def cmd_map(keyword_args, as_json=False, limit=12):
    cache = load_index()
    graph = cache.get("graph") or build_workspace_graph(
        cache.get("records", {}), cache.get("assets", []))
    if keyword_args:
        routed = _route_records(cache, keyword_args, limit=limit)
        keys = {x[1] for x in routed}
        domains = {}
        for key in keys:
            rec = cache["records"][key]
            d = domains.setdefault(rec["domain"], {})
            d[rec["pipeline"]] = d.get(rec["pipeline"], 0) + 1
    else:
        domains = {dn: {pn: pv["count"] for pn, pv in dv["pipelines"].items()}
                   for dn, dv in graph.get("domains", {}).items()}
    payload = {
        "schema_version": cache.get("schema_version"),
        "built_at": cache.get("built_at"),
        "remote_reachable": cache.get("remote_reachable"),
        "workspace_count": graph.get("workspace_count", 0),
        "asset_count": graph.get("asset_count", 0),
        "dependency_edges": graph.get("edge_count", 0),
        "domains": domains,
    }
    if as_json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0
    print("Workspace Graph: %d 工作区 / %d 云资产 / %d 图边 / peer=%s" % (
        payload["workspace_count"], payload["asset_count"], payload["dependency_edges"],
        "online" if payload["remote_reachable"] else "cached"))
    for domain in sorted(domains):
        pipes = sorted(domains[domain].items(), key=lambda x: (-x[1], x[0]))
        shown = pipes[:limit]
        print("\n%s (%d)" % (domain, sum(v for _, v in pipes)))
        for pipeline, count in shown:
            print("  └─ %s (%d)" % (pipeline, count))
        if len(pipes) > len(shown):
            print("  └─ …另 %d 条产线" % (len(pipes) - len(shown)))
    return 0


def cmd_route(keyword_args, as_json=False, limit=10):
    cache = load_index()
    if not as_json:
        _report_cache_status(cache)
    routed = _route_records(cache, keyword_args, limit=limit)
    payload = []
    for score, key, rec, matched in routed:
        payload.append({
            "kind": "workspace", "score": score, "matched": matched,
            "domain": rec.get("domain"),
            "domain_source": rec.get("domain_source"), "pipeline": rec.get("pipeline"),
            "host": rec.get("host"), "path": rec.get("path"), "what": rec.get("what"),
            "dependencies": rec.get("dependencies") or [],
            "next": "ws show %s" % shlex.quote(rec.get("path", "")),
        })
    kws = []
    for arg in keyword_args:
        kws.extend(arg.lower().split())
    for score, asset, matched in pager.asset_search(cache.get("assets", []), kws, limit=limit):
        payload.append({
            "kind": "cloud_asset", "score": score, "matched": matched,
            "asset_id": asset.get("asset_id"), "host": asset.get("host"),
            "path": asset.get("original_path"), "what": asset.get("description"),
            "size_bytes": asset.get("size_bytes"),
            "cloud_verified": asset.get("cloud_verified"),
            "restore_verified": asset.get("restore_verified"),
            "next": "ws page enter --asset-id %s" % shlex.quote(asset.get("asset_id", "")),
        })
    for tool in load_function_foundry():
        matched = []
        score = 0
        fields = (("tool_id", 18), ("repo", 14), ("description", 6),
                  ("keywords", 5), ("status", 3))
        for kw in kws:
            hit = False
            for name, weight in fields:
                value = tool.get(name, "")
                if isinstance(value, list): value = " ".join(map(str, value))
                if kw in str(value).casefold(): score += weight; hit = True
            if hit: matched.append(kw)
        if kws and len(matched) == len(kws): score += 20
        if not score: continue
        if tool.get("callable"): score += 25
        elif tool.get("status") == "quarantine": score += 5
        payload.append({"kind": "function_tool", "score": score, "matched": matched,
                        "tool_id": tool.get("tool_id"), "repo": tool.get("repo"),
                        "status": tool.get("status"), "tier": tool.get("tier"),
                        "callable": tool.get("callable"), "commit": tool.get("commit"),
                        "what": tool.get("description"), "next": tool.get("next")})
    capability_result = capability_search(" ".join(keyword_args), limit=min(10, limit))
    if capability_result:
        backend = capability_result.get("source") or capability_result.get("mode")
        for rank, card in enumerate(capability_result.get("matches", []), 1):
            entrypoints = card.get("entrypoints") or []
            next_cmd = (entrypoints[0] if card.get("callable") and entrypoints else
                        "describe_tool %s" % shlex.quote(card.get("tool_id", "")))
            payload.append({
                "kind": "capability", "score": 150 - rank,
                "matched": card.get("aliases") or [],
                "card_id": card.get("card_id"), "tool_id": card.get("tool_id"),
                "capability_id": card.get("capability_id"), "title": card.get("title"),
                "what": card.get("intent"), "scenarios": card.get("scenarios") or [],
                "anti_scenarios": card.get("anti_scenarios") or [],
                "status": card.get("status"), "tier": card.get("tier"),
                "callable": card.get("callable"), "evidence": card.get("evidence") or [],
                "retrieval_backend": backend,
                "semantic_score": card.get("semantic_score"),
                "next": next_cmd,
            })
    pg = pager.WorkspacePager()
    assets_by_id = {a.get("asset_id"): a for a in cache.get("assets", [])}
    grouped_files = {}
    for file_hit in pg.search_asset_files(kws, limit=max(100, limit * 20)):
        grouped_files.setdefault(file_hit["asset_id"], []).append(file_hit)
    for asset_id, file_hits in grouped_files.items():
        asset = assets_by_id.get(asset_id, {})
        confirmed = bool(asset.get("cloud_verified"))
        payload.append({
            "kind": "cloud_file", "score": (60 if confirmed else 25) + 5 * len(kws),
            "matched": kws, "asset_id": asset_id, "host": asset.get("host"),
            "path": asset.get("original_path"), "relative_path": file_hits[0]["relative_path"],
            "file_matches": file_hits[:10], "match_count": len(file_hits),
            "what": asset.get("description"), "size_bytes": file_hits[0]["size_bytes"],
            "cloud_verified": confirmed,
            "restore_verified": asset.get("restore_verified"),
            "search_backend": file_hits[0].get("search_backend"),
            "next": "ws page enter --asset-id %s" % shlex.quote(asset_id),
        })
    payload.sort(key=lambda x: (-x["score"], x["kind"], x.get("path") or ""))
    payload = payload[:limit]
    if as_json:
        print(json.dumps({"query": " ".join(keyword_args),
                          "cache_status": cache.get("cache_status"),
                          "capability_retrieval": ({
                              "source": capability_result.get("source"),
                              "mode": capability_result.get("mode"),
                              "engine": capability_result.get("engine"),
                              "package_version": capability_result.get("package_version"),
                              "semantic_status": capability_result.get("semantic_status"),
                              "embedding_model": capability_result.get("embedding_model"),
                              "embedding_device": capability_result.get("embedding_device"),
                          } if capability_result else {"source": None, "mode": "unavailable"}),
                          "matches": payload},
                         ensure_ascii=False, indent=2))
        return 0
    if not payload:
        print("NO_MATCH")
        print("目录与云资产索引均未命中；再用 memory-service 理解同义表达，或 ws map 查看全貌。")
        return 0
    for i, item in enumerate(payload, 1):
        if item["kind"] == "capability":
            print("%d. [能力] %s → %s:%s backend=%s" % (
                i, item.get("title") or item.get("what"), item.get("tool_id"),
                item.get("capability_id"), item.get("retrieval_backend")))
            print("   %s" % (item.get("what") or "(无意图说明)"))
            if item.get("anti_scenarios"):
                print("   不适用: %s" % "；".join(item["anti_scenarios"][:3]))
            print("   入口: %s" % item["next"])
            continue
        if item["kind"] == "function_tool":
            print("%d. [Function] %s status=%s tier=%s callable=%s" % (
                i, item.get("tool_id") or item["repo"], item["status"],
                item["tier"], item["callable"]))
            print("   %s" % (item.get("what") or "(无描述)"))
            print("   下钻: %s" % item["next"])
            continue
        if item["kind"] == "cloud_file":
            print("%d. [云内文件] %s :: %s (同asset命中%d条)" % (
                i, item["asset_id"], item["relative_path"], item["match_count"]))
            print("   原根: %s [%s] | 文件大小=%s" % (
                item["path"], item["host"], item["size_bytes"]))
            print("   换入: %s" % item["next"])
            continue
        if item["kind"] == "cloud_asset":
            print("%d. [冷资产] %s → %s [%s]" % (
                i, item["asset_id"], item["path"], item["host"]))
            print("   %s" % (item["what"] or "(无描述)"))
            print("   云确认=%s 恢复验收=%s 大小=%s" % (
                item["cloud_verified"], item["restore_verified"], item["size_bytes"]))
            print("   换入: %s" % item["next"])
            continue
        inferred = " [推断]" if item["domain_source"] == "inferred" else ""
        peer = " [对侧:%s]" % item["host"] if item["host"] != HOST else ""
        print("%d. %s%s → %s → %s%s" % (
            i, item["domain"], inferred, item["pipeline"], item["path"], peer))
        print("   %s" % (item["what"] or "(未填这是什么)"))
        print("   下钻: %s" % item["next"])
        if item["dependencies"]:
            print("   依赖: %s" % ", ".join(item["dependencies"][:4]))
    return 0


def _resolve_target(cache, target):
    target_abs = os.path.abspath(os.path.expanduser(target)) if target.startswith(("/", "~", ".")) else None
    recs = list(cache["records"].values())
    if target_abs:
        # 精确本机路径优先信实测,不信可能过期的索引缓存——
        # 否则 ws new 建区后立刻 ws show 会因缓存里没有/有过期条目而被模糊匹配抢到别的子目录。
        hp = os.path.join(target_abs, "HANDOFF.md")
        if os.path.isfile(hp):
            return build_record_from_file(hp, HOST)
        for r in recs:
            if r["path"] == target_abs or r["path"].rstrip("/") == target_abs.rstrip("/"):
                return r
    low = target.lower()
    exact = [r for r in recs if r["name"].lower() == low]
    if exact:
        return exact[0]
    sub = [r for r in recs if low in r["name"].lower() or low in r["path"].lower()]
    return sub[0] if sub else None


def cmd_show(target):
    cache = load_index()
    rec = _resolve_target(cache, target)
    if not rec:
        print("NO_MATCH: 找不到工作区 '%s'" % target)
        return 1
    if not rec.get("has_handoff"):
        print("%s: 尚无 HANDOFF.md(证据: %s)" % (rec["path"], rec.get("evidence", "")))
        return 1
    text = None
    if rec["host"] == HOST:
        try:
            text = open(rec["handoff_path"], encoding="utf-8", errors="replace").read()
        except OSError:
            text = None
    else:
        text = fetch_remote_file(rec["handoff_path"])
    if text is not None:
        parsed = parse_handoff_text(text)
        print("== 当前态 ==")
        print(parsed["current_state_raw"] or "(空)")
        print("")
        print("== 必用 skill ==")
        print(parsed["skills_raw"] or "(空)")
    else:
        print("(对侧不可达或本机读取失败,展示索引缓存,可能过期)")
        print("== 当前态(缓存)==")
        print("这是什么: %s\n产线: %s\n做到哪: %s\n下一道门: %s\n卡点: %s" % (
            rec.get("what"), rec.get("line"), rec.get("progress"),
            rec.get("next_gate"), rec.get("blocker")))
        if rec.get("recent_task"):
            print("最近任务(缓存): " + recent_task_text(rec))
        print("")
        print("== 必用 skill(缓存)==")
        for s in rec.get("skills", []):
            print("- %s%s — %s" % ("⭐ " if s.get("star") else "", s["name"], s.get("note", "")))
    try:
        pager.WorkspacePager().touch(rec.get("host") or HOST, rec["path"], "ws show")
    except Exception as exc:
        print("警告:页表访问记账失败:%s" % exc, file=sys.stderr)
    return 0


