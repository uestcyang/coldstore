def cmd_state(path, chain, progress, next_gate, blocker, what=None):
    """原子刷新「当前态」里的任务游标,不覆盖已有富文本现态。

    对 ws new/scaffold 留下的真空字段直接补值；若字段已有单行或缩进续文，
    保留原文，只更新一条唯一的「最近任务」游标。这样不会拿通用任务摘要
    覆盖人工维护的多行权威状态，同时新建工作区不再永久停在空模板。
    """
    path = os.path.abspath(os.path.expanduser(path))
    err = _cross_host_error(path)
    if err:
        print(err)
        return 2
    hp = os.path.join(path, "HANDOFF.md")

    def one_line(value, name, required=False):
        if value is None:
            if required:
                raise ValueError("%s 不能为空" % name)
            return None
        value = re.sub(r"\s+", " ", str(value)).strip().replace("|", "／")
        if required and not value:
            raise ValueError("%s 不能为空" % name)
        return value

    try:
        progress = one_line(progress, "progress", required=True)
        next_gate = one_line(next_gate, "next_gate", required=True)
        blocker = one_line(blocker, "blocker")
        what = one_line(what, "what")
        chain = one_line(chain, "chain", required=True)
    except ValueError as e:
        print("ERROR: %s" % e)
        return 2

    ts = time.strftime("%F %H:%M")
    filled = []

    def mutate(lines):
        idx = _block_ranges(lines)
        if "当前态" not in idx:
            raise ValueError("缺块 [当前态],无法刷新")
        start = idx["当前态"]
        later = sorted(v for v in idx.values() if v > start)
        end = later[0] if later else len(lines)
        out = list(lines)
        values = {"做到哪": progress, "下一道门": next_gate}
        if what is not None:
            values["这是什么"] = what
        if blocker is not None:
            values["卡点"] = blocker

        for field, value in values.items():
            hits = []
            for i in range(start + 1, end):
                m = STATE_UPDATE_RE[field].match(out[i])
                if m:
                    hits.append((i, m))
            if not hits:
                continue
            i, m = hits[-1]
            if m.group(2).strip():
                continue
            multiline = False
            for j in range(i + 1, end):
                nxt = out[j]
                if not nxt.strip():
                    continue
                if any(rx.match(nxt) for rx in STATE_UPDATE_RE.values()):
                    break
                if nxt.startswith(("  ", "\t")) or not nxt.startswith(("-", "*", "|", "#")):
                    multiline = True
                break
            if not multiline:
                out[i] = m.group(1) + value
                filled.append(field)

        recent = ("- 最近任务:%s | %s | 做到哪:%s | 下一道门:%s%s"
                  % (ts, chain, progress, next_gate,
                     (" | 卡点:%s" % blocker) if blocker is not None else ""))
        recent_hits = [i for i in range(start + 1, end) if RECENT_TASK_RE.match(out[i])]
        if recent_hits:
            out[recent_hits[-1]] = recent
        else:
            out = _append_to_block(out, "当前态", recent)
        return out, "已刷新当前任务游标(补空字段:%s)" % (",".join(filled) or "无")

    try:
        ok, msg = _locked_rewrite(hp, mutate)
    except ValueError as e:
        print(str(e))
        return 1
    print(msg if ok else ("失败: %s" % msg))
    if ok:
        _bus(path, "state", chain=chain, progress=progress,
             next_gate=next_gate, blocker=blocker, what=what)
    return 0 if ok else 1


def cmd_dep(path, add, chain):
    """原子、去重地在「当前态」声明一条跨工作区依赖，并同步追加日志。"""
    path = os.path.abspath(os.path.expanduser(path))
    err = _cross_host_error(path)
    if err:
        print(err)
        return 2
    hp = os.path.join(path, "HANDOFF.md")
    add = os.path.normpath(os.path.expanduser(str(add).strip()))
    chain = re.sub(r"\s+", " ", str(chain).strip()).replace("|", "／")
    if not os.path.isabs(add) or add == "/" or "\n" in add or "\r" in add:
        print("ERROR: --add 必须是具体绝对工作区路径")
        return 2
    if not chain:
        print("ERROR: --chain 不能为空")
        return 2
    ts = time.strftime("%F %H:%M")

    def mutate(lines):
        idx = _block_ranges(lines)
        if "当前态" not in idx or "修改日志" not in idx:
            raise ValueError("缺块 [当前态/修改日志],无法声明依赖")
        start = idx["当前态"]
        later = sorted(v for v in idx.values() if v > start)
        end = later[0] if later else len(lines)
        out = list(lines)
        dep_i = None
        deps = []
        for i in range(start + 1, end):
            m = DEP_LINE_RE.match(out[i])
            if not m:
                continue
            dep_i = i
            deps = [os.path.normpath(os.path.expanduser(x.strip()))
                    for x in re.split(r"[,，]", m.group(2)) if x.strip()]
            if add in deps:
                return None, "已存在,未重复添加: %s" % add
            out[i] = m.group(1) + m.group(2).rstrip() + ", " + add
            break
        if dep_i is None:
            out = _append_to_block(out, "当前态", "- 依赖: %s" % add)
        log_line = "- %s | %s | 声明当前跨区依赖:%s | 工作区依赖审计" % (ts, chain, add)
        out = _append_to_block(out, "修改日志", log_line)
        return out, "已声明依赖: %s" % add

    try:
        ok, msg = _locked_rewrite(hp, mutate)
    except ValueError as e:
        print(str(e))
        return 1
    print(msg if ok else ("失败: %s" % msg))
    if ok:
        _bus(path, "dep", chain=chain, dependency=add, what="声明依赖 %s" % add)
    return 0 if ok else 1


# ── 事件总线(<date>)──────────────────────────────────────────────────
# `ws log`/`ws skill` 的结构化副本。HANDOFF.md 正文是给人读的散文,
# 事件流是给 agent 读的结构 —— 同一次记账两处落地,正文仍是唯一权威。
# 整段 fail-open:总线挂了绝不让记账失败(记账成功比记事件重要)。
def _bus(path, ev, **kw):
    try:
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        import ws_bus
        kw.setdefault("task", os.environ.get("HD_TASK_ID") or os.environ.get("PAI_TASK_ID"))
        return ws_bus.emit(path, ev, **kw)
    except Exception:
        return False


def cmd_brief(path, window, as_json, me, no_peer=False):
    """ws brief —— agent 协作视图:谁在动/标准变没变/会不会撞车。

    这是「agent 可以直接据此协作」的读出口。转调 ws_bus,不写第二套判据。
    跨机聚合:对端机器同名工作区的事件流一并展示(走 ssh,不可达静默降级),
    实现见 ws_bus.brief_with_peer(<date> 任务B)。
    """
    path = os.path.abspath(os.path.expanduser(path))
    try:
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        import ws_bus
    except Exception as e:
        print("ERROR: ws_bus 不可用: %r" % e)
        return 3
    composite = ws_bus.brief_with_peer(path, window=window, now=time.time(),
                                       me=me, want_peer=not no_peer)
    d = composite["local"]
    pd = composite["peer"]
    if as_json:
        out = {"local": d, "peer": pd}
        print(json.dumps(out, ensure_ascii=False, indent=1, default=str))
        return 0
    print("== 工作区活动 %s ==" % path)
    t = ws_bus.brief_text(path, window=window, now=time.time(), me=me, d=d)
    if pd and pd.get("n_events"):
        pt = ws_bus.brief_text(path, window=window, now=time.time(), me=me, d=pd)
        if pt:
            t = (t + "\n" if t else "") + ("[对端 %s]\n" % ws_bus.PEER_HOST) + pt
    print(t if t else "(事件流为空:还没有任何 agent 动作被观测到)")
    return 0


def cmd_skill(path, add, star, note):
    path = os.path.abspath(os.path.expanduser(path))
    err = _cross_host_error(path)
    if err:
        print(err)
        return 2
    hp = os.path.join(path, "HANDOFF.md")

    def mutate(lines):
        idx = _block_ranges(lines)
        if "必用skill" not in idx:
            raise ValueError("缺块 [必用skill],无法追加")
        start = idx["必用skill"]
        later = sorted(v for v in idx.values() if v > start)
        end = later[0] if later else len(lines)
        for i in range(start + 1, end):
            s = lines[i].strip()
            if not s.startswith("-"):
                continue
            m = SKILL_RE.match(s)
            if m and m.group(2).lower() == add.lower():
                if star and not m.group(1):
                    stripped = s[1:].strip()
                    lines[i] = "- ⭐ " + stripped
                    return lines, "已存在,补标 ⭐: %s" % add
                return None, "已存在,未重复添加: %s" % add
        new_line = "- %s`%s`%s" % ("⭐ " if star else "", add,
                                    (" — %s" % note) if note else "")
        return _append_to_block(lines, "必用skill", new_line), "已追加: %s" % new_line

    try:
        ok, msg = _locked_rewrite(hp, mutate)
    except ValueError as e:
        print(str(e))
        return 1
    print(msg if ok else ("失败: %s" % msg))
    if ok:
        _bus(path, "skill", skill=add, what="必用skill +%s" % add, star=bool(star))
    return 0 if ok else 1


