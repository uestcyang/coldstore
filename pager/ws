    sp = sub.add_parser("brief", help="工作区活动视图(谁在动/标准变没变/会不会撞车),转调 ws_bus")
    sp.add_argument("path")
    sp.add_argument("--window", type=float, default=7 * 86400, help="回看窗口秒数,默认 7 天")
