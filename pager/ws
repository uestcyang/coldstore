def _block_ranges(lines):
    idx = {}
    for i, ln in enumerate(lines):
        s = ln.strip()
        for name, rx in BLOCKS.items():
            if name not in idx and rx.match(s):
                idx[name] = i
    return idx


def parse_handoff_text(text):
    from shared_context_policy import public_text
    lines = public_text(text).splitlines()
    idx = _block_ranges(lines)

    def block(name):
        if name not in idx:
            return []
        start = idx[name] + 1
        later = sorted(v for v in idx.values() if v > idx[name])
        end = later[0] if later else len(lines)
        return lines[start:end]

    cur_lines = block("当前态")
    skill_lines = block("必用skill")

    fields = {"what": "", "line": "", "progress": "", "next_gate": "", "blocker": "",
              "domain": ""}
    dependencies = []
    for ln in cur_lines:
        m = FIELD_RE.match(ln.strip())
        if not m:
            continue
        key, val = m.group(1), m.group(2).strip()
        if "这是什么" in key:
            fields["what"] = val
        elif "产线" in key:
            fields["line"] = val
        elif "做到哪" in key:
            fields["progress"] = val
        elif "下一道门" in key:
            fields["next_gate"] = val
        elif "卡点" in key:
            fields["blocker"] = val
        elif "领域" in key:
            fields["domain"] = val
        mdep = DEP_LINE_RE.match(ln)
        if mdep:
            dependencies.extend(os.path.normpath(os.path.expanduser(x.strip()))
                                for x in re.split(r"[,，]", mdep.group(2)) if x.strip())

    skills = []
    for ln in skill_lines:
        s = ln.strip()
        if not s.startswith("-"):
            continue
        m = SKILL_RE.match(s)
        if not m:
            continue
        name = m.group(2)
        if not name:
            continue
        skills.append({"name": name, "star": bool(m.group(1)), "note": m.group(3).strip()})

    return {
        "fields": fields, "skills": skills,
        "dependencies": sorted(set(dependencies)),
        "recent_task": parse_recent_task(cur_lines),
        "current_state_raw": "\n".join(cur_lines).strip(),
        "skills_raw": "\n".join(skill_lines).strip(),
    }


def parse_recent_task(lines):
    for line in lines:
        if not RECENT_TASK_RE.match(line):
            continue
        chunks = re.split(r"[:：]", line, maxsplit=1)[1].strip().split("|")
        if len(chunks) < 4:
            return None
        values = {}
        for chunk in chunks[2:]:
            pair = re.split(r"[:：]", chunk.strip(), maxsplit=1)
            if len(pair) == 2:
                values[pair[0].strip()] = pair[1].strip()
        if not values.get("做到哪") or not values.get("下一道门"):
            return None
        return {"ts": chunks[0].strip(), "chain": chunks[1].strip(),
                "progress": values["做到哪"], "next_gate": values["下一道门"],
                "blocker": values.get("卡点")}
    return None


def recent_task_text(record):
    recent = record.get("recent_task") or {}
    return " | ".join(str(recent.get(field) or "") for field in
                      ("ts", "chain", "progress", "next_gate", "blocker")) if recent else ""


def build_record_from_text(handoff_path, text, mtime, host, evidence="HANDOFF.md 存在"):
    parsed = parse_handoff_text(text)
    ws_dir = os.path.dirname(handoff_path.rstrip("/"))
    rec = {
        "path": ws_dir, "handoff_path": handoff_path, "host": host,
        "name": os.path.basename(ws_dir.rstrip("/")) or ws_dir,
        "has_handoff": True,
        "mtime": mtime,
        "dispatch_refs": 0, "dispatch_labels": [],
        "priority": None, "evidence": evidence, "verified": True,
    }
    rec.update(parsed["fields"])
    rec["skills"] = parsed["skills"]
    rec["dependencies"] = parsed["dependencies"]
    rec["recent_task"] = parsed["recent_task"]
    return rec


def build_record_from_file(handoff_path, host):
    try:
        text = open(handoff_path, encoding="utf-8", errors="replace").read()
        mtime = os.path.getmtime(handoff_path)
    except OSError:
        text, mtime = "", 0
    return build_record_from_text(handoff_path, text, mtime, host)


def make_bare_record(path, host, evidence, priority="P1", dispatch_refs=0,
                      dispatch_labels=None, verified=True):
    return {
        "path": path, "handoff_path": None, "host": host,
        "name": os.path.basename(path.rstrip("/")) or path,
        "has_handoff": False,
        "what": "", "line": "", "progress": "", "next_gate": "", "blocker": "",
        "domain": "", "dependencies": [],
        "skills": [], "mtime": None,
        "dispatch_refs": dispatch_refs, "dispatch_labels": dispatch_labels or [],
        "priority": priority, "evidence": evidence, "verified": verified,
    }


def load_function_foundry():
    for path in FUNCTION_FOUNDRY_INDEX_PATHS:
        rows = []
        try:
            with open(path, encoding="utf-8") as f:
                for line in f:
                    if line.strip():
                        rows.append(json.loads(line))
            return rows
        except (OSError, json.JSONDecodeError):
            continue
    return []


def load_function_storage():
    for path in FUNCTION_FOUNDRY_STORAGE_PATHS:
        try:
            value = json.load(open(path, encoding="utf-8"))
            if value.get("schema_version") == 1:
                return value.get("storage", [])
        except (OSError, json.JSONDecodeError, AttributeError):
