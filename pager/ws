        print(err)
        return 2
    os.makedirs(path, exist_ok=True)
    hp = os.path.join(path, "HANDOFF.md")
    ts = time.strftime("%F %H:%M")
    nm = name or (os.path.basename(path.rstrip("/")) or path)
    chain = default_chain()
    content = TEMPLATE.format(name=nm, ts=ts, what=what or "", line=line or "无", chain=chain)
